<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="bayt_alebaa_qa_lab_default" model="bayt.alebaa.simulator">
        <field name="name">Bayt Alebaa QA Lab</field>
        <field name="mock_wati">True</field>
    </record>

    <!-- Bayt Alebaa CRM stage discovered in staging. A high sequence keeps
         the simulator transition deterministic so Run State Transitions
         moves the newest lead into this exact stage. -->
    <record id="crm_stage_taking_measurements" model="crm.stage">
        <field name="name">Taking measurements</field>
        <field name="sequence">999</field>
    </record>
</odoo>
