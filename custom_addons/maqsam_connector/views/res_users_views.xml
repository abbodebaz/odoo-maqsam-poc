<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_maqsam" model="ir.ui.view">
        <field name="name">res.users.form.maqsam</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Maqsam" name="maqsam_user_integration">
                    <group>
                        <group string="ربط حساب الموظف">
                            <field name="maqsam_agent_email" string="Maqsam Agent Email" placeholder="employee@company.com"/>
                            <div class="text-muted">
                                أدخل إيميل الموظف كما هو مسجل داخل Maqsam. سيتم استخدام هذا الحساب للـDialer والمكالمات وسجل الموظف.
                            </div>
                        </group>
                        <group string="الصلاحيات" groups="base.group_system">
                            <field name="maqsam_supervisor" string="مشرف Maqsam"/>
                            <div class="text-muted">
                                المشرف يستطيع مشاهدة مكالمات وتسجيلات وحالات جميع Agents. الموظف العادي يرى بياناته فقط.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
