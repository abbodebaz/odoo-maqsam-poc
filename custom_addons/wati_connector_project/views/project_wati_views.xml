<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_form_wati" model="ir.ui.view">
        <field name="name">project.task.form.wati</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_wati_inbox" type="object" class="oe_stat_button" icon="fa-comments" help="Open a conversation WhatsApp Associated with the task client">
                    <field name="wati_conversation_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp" name="wati_whatsapp">
                    <group>
                        <group string="Conversation">
                            <field name="wati_conversation_count" readonly="1"/>
                            <field name="wati_message_count" readonly="1"/>
                            <field name="wati_last_message_at" readonly="1"/>
                            <field name="wati_last_status" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_open_wati_inbox" type="object" string="Open a box WhatsApp" class="btn-primary" icon="fa-comments"/>
                            <button name="action_open_wati_conversations" type="object" string="View conversation history" class="btn-secondary" icon="fa-list"/>
                        </group>
                    </group>
                    <group string="Last message">
                        <field name="wati_last_message" readonly="1" nolabel="1" placeholder="No messages WhatsApp Until now."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_wati_conversation_form_project" model="ir.ui.view">
        <field name="name">wati.conversation.form.project</field>
        <field name="model">wati.conversation</field>
        <field name="inherit_id" ref="wati_connector.view_wati_conversation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_project_tasks" type="object" string="Project tasks" class="btn-secondary" icon="fa-tasks" invisible="project_task_count == 0"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_task_count" readonly="1"/>
                <field name="project_task_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_wati_conversation_list_project" model="ir.ui.view">
        <field name="name">wati.conversation.list.project</field>
        <field name="model">wati.conversation</field>
        <field name="inherit_id" ref="wati_connector.view_wati_conversation_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_task_count" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
