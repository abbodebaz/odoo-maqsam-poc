<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_template_search" model="ir.ui.view">
        <field name="name">wati.template.search</field>
        <field name="model">wati.template</field>
        <field name="arch" type="xml">
            <search string="بحث في قوالب WhatsApp">
                <field name="name" string="اسم القالب"/>
                <field name="language" string="اللغة"/>
                <field name="category" string="التصنيف"/>
                <field name="status" string="الحالة"/>
                <field name="channel_phone_number" string="القناة"/>
                <separator/>
                <filter name="draft" string="مسودات" domain="[('status', '=', 'draft')]"/>
                <filter name="pending" string="قيد المراجعة" domain="[('status', 'in', ['pending', 'pending_internal'])]"/>
                <filter name="approved" string="معتمدة" domain="[('status', '=', 'approved')]"/>
                <filter name="rejected" string="مرفوضة" domain="[('status', '=', 'rejected')]"/>
                <filter name="attention" string="تحتاج انتباه" domain="[('status', 'in', ['rejected', 'paused', 'disabled', 'unknown'])]"/>
                <separator/>
                <filter name="odoo_source" string="أنشئت في Odoo" domain="[('source', '=', 'odoo')]"/>
                <filter name="wati_source" string="مستوردة من WATI" domain="[('source', '=', 'wati')]"/>
                <separator/>
                <group>
                    <filter name="group_status" string="الحالة" context="{'group_by': 'status'}"/>
                    <filter name="group_category" string="التصنيف" context="{'group_by': 'category'}"/>
                    <filter name="group_language" string="اللغة" context="{'group_by': 'language'}"/>
                    <filter name="group_source" string="المصدر" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wati_template_list" model="ir.ui.view">
        <field name="name">wati.template.list</field>
        <field name="model">wati.template</field>
        <field name="arch" type="xml">
            <list string="مركز قوالب WhatsApp"
                  default_order="write_date desc, id desc"
                  decoration-success="status == 'approved'"
                  decoration-danger="status == 'rejected'"
                  decoration-warning="status in ['pending', 'pending_internal', 'paused']"
                  decoration-muted="status in ['disabled', 'deleted']">
                <header>
                    <button name="action_sync_from_wati"
                            type="object"
                            string="مزامنة من WATI"
                            icon="fa-refresh"
                            class="btn-primary"
                            display="always"/>
                </header>
                <field name="name" string="القالب"/>
                <field name="language" string="اللغة"/>
                <field name="category" string="التصنيف"/>
                <field name="status" string="الحالة" widget="badge"/>
                <field name="quality" string="الجودة" widget="badge"/>
                <field name="source" string="المصدر" optional="show"/>
                <field name="variable_count" string="المتغيرات"/>
                <field name="channel_phone_number" string="القناة" optional="hide"/>
                <field name="last_synced_at" string="آخر مزامنة" optional="show"/>
                <field name="submitted_at" string="أرسل للمراجعة" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wati_template_form" model="ir.ui.view">
        <field name="name">wati.template.form</field>
        <field name="model">wati.template</field>
        <field name="arch" type="xml">
            <form string="قالب WhatsApp" delete="false">
                <header>
                    <button name="action_submit_for_approval"
                            type="object"
                            string="إرسال للمراجعة"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="status != 'draft' or source != 'odoo'"/>
                    <button name="action_refresh_status"
                            type="object"
                            string="تحديث الحالة"
                            icon="fa-refresh"
                            invisible="status == 'draft' and not wati_template_id and not meta_template_id"/>
                    <button name="action_duplicate_draft"
                            type="object"
                            string="إنشاء نسخة جديدة"
                            icon="fa-copy"
                            invisible="status == 'draft' and source == 'odoo'"/>
                    <button name="action_delete_remote"
                            type="object"
                            string="حذف من WATI / Meta"
                            icon="fa-trash"
                            class="btn-secondary"
                            confirm="سيتم طلب حذف هذه النسخة من WATI/Meta. لا يمكن التراجع عن هذا الإجراء. هل أنت متأكد؟"
                            invisible="status == 'draft' and not wati_template_id and not meta_template_id"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,pending,pending_internal,approved,rejected,paused,disabled,deleted"/>
                </header>

                <sheet>
                    <div class="alert alert-info" role="status" invisible="source != 'wati'">
                        <strong>قالب مستورد من WATI.</strong>
                        هذه النسخة مرآة للحالة الموجودة لدى WATI/Meta. إذا أردت تعديل المحتوى استخدم «إنشاء نسخة جديدة» حتى لا نفصل بيانات Odoo عن القالب الحقيقي.
                    </div>
                    <div class="alert alert-warning" role="status" invisible="sub_category in [False, '', 'STANDARD']">
                        هذا قالب متقدم من نوع <field name="sub_category" class="d-inline"/>. يتم عرضه ومراقبته داخل Odoo، لكن إنشاء الأنواع المتقدمة من Odoo غير مفعّل حتى يكون عقد الـAPI موثقًا بالكامل.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="status != 'rejected' or not rejection_reason">
                        <strong>رفض Meta القالب:</strong>
                        <field name="rejection_reason" class="d-inline"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <strong>آخر مشكلة في المزامنة:</strong>
                        <field name="last_error" class="d-inline"/>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="اسم القالب"/>
                        <h1>
                            <field name="name"
                                   placeholder="order_ready_ar"
                                   readonly="status != 'draft' or source != 'odoo'"/>
                        </h1>
                        <div class="text-muted">
                            الاسم ثابت بعد الإرسال ويجب أن يكون بحروف إنجليزية صغيرة وأرقام وشرطة سفلية فقط.
                        </div>
                    </div>

                    <group>
                        <group string="الهوية">
                            <field name="language" readonly="status != 'draft' or source != 'odoo'" placeholder="ar"/>
                            <field name="category" readonly="status != 'draft' or source != 'odoo'"/>
                            <field name="sub_category"/>
                            <field name="source"/>
                        </group>
                        <group string="حالة Meta / WATI">
                            <field name="status" widget="badge"/>
                            <field name="quality" widget="badge"/>
                            <field name="submitted_at"/>
                            <field name="last_synced_at"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="المحتوى" name="content">
                            <group>
                                <field name="body"
                                       string="نص الرسالة"
                                       placeholder="مرحبًا {{name}}، طلبك أصبح جاهزًا."
                                       readonly="status != 'draft' or source != 'odoo'"
                                       nolabel="1"/>
                            </group>

                            <group string="متغيرات القالب" invisible="not variable_count">
                                <div class="text-muted mb-2">
                                    قيمة المثال ترسل مع تعريف القالب لمساعدة المراجعة وفهم شكل الرسالة. استخدم بيانات واقعية وغير حساسة.
                                </div>
                                <field name="variable_ids" readonly="status != 'draft' or source != 'odoo'" nolabel="1">
                                    <list editable="bottom" create="false" delete="false">
                                        <field name="position" string="#" readonly="1"/>
                                        <field name="name" string="المتغير" readonly="1"/>
                                        <field name="sample_value" string="قيمة مثال" required="1"/>
                                    </list>
                                </field>
                            </group>

                            <group string="معاينة الرسالة">
                                <field name="preview_text" readonly="1" nolabel="1"/>
                            </group>

                            <group string="تفاصيل إضافية">
                                <field name="footer" readonly="status != 'draft' or source != 'odoo'" placeholder="اختياري — حتى 60 حرفًا"/>
                                <field name="header_type" invisible="not header_type"/>
                                <field name="header_text" invisible="not header_text"/>
                            </group>
                        </page>

                        <page string="الاعتماد والمزامنة" name="provider">
                            <div class="alert alert-light border" role="status">
                                <strong>دورة حياة القالب:</strong>
                                مسودة في Odoo ← إرسال إلى WATI ← مراجعة Meta ← اعتماد أو رفض ← متابعة الجودة والتصنيف عبر Webhook.
                            </div>
                            <group>
                                <group string="المعرفات">
                                    <field name="wati_template_id"/>
                                    <field name="meta_template_id"/>
                                    <field name="waba_id"/>
                                    <field name="channel_phone_number"/>
                                </group>
                                <group string="المراجعة">
                                    <field name="submitted_at"/>
                                    <field name="last_synced_at"/>
                                    <field name="rejection_reason" invisible="not rejection_reason"/>
                                </group>
                            </group>
                        </page>

                        <page string="مكونات مستوردة" name="imported_components" invisible="not header_type and not header_text and buttons_json in [False, '', '[]']">
                            <group>
                                <field name="header_type"/>
                                <field name="header_text"/>
                                <field name="buttons_json" widget="text"/>
                            </group>
                        </page>

                        <page string="تفاصيل تقنية" name="technical" groups="base.group_system">
                            <group>
                                <field name="provider_request" widget="text"/>
                                <field name="provider_response" widget="text"/>
                                <field name="last_error" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wati_templates" model="ir.actions.act_window">
        <field name="name">مركز القوالب</field>
        <field name="res_model">wati.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wati_template_search"/>
        <field name="context">{'default_source': 'odoo', 'default_status': 'draft'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ابدأ بإضافة أول قالب WhatsApp</p>
            <p>أنشئ مسودة في Odoo أو اضغط «مزامنة من WATI» لاستيراد القوالب الحالية ومتابعة اعتمادها.</p>
        </field>
    </record>

    <menuitem id="menu_wati_templates"
              name="مركز القوالب"
              parent="wati_connector.menu_wati_root"
              action="action_wati_templates"
              sequence="25"
              groups="wati_connector.group_wati_admin,base.group_system"/>
</odoo>
