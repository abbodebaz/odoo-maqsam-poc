<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_wati_workspace" model="ir.actions.client">
        <field name="name">WhatsApp</field>
        <field name="tag">wati_connector.workspace</field>
    </record>

    <record id="action_wati_help_center" model="ir.actions.client">
        <field name="name">مركز المساعدة</field>
        <field name="tag">wati_connector.help_center</field>
    </record>

    <record id="action_wati_settings" model="ir.actions.act_window">
        <field name="name">إعدادات WhatsApp</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'wati_connector'}</field>
    </record>

    <!-- Make the app launcher open the workspace instead of the large inbox. -->
    <record id="menu_wati_root" model="ir.ui.menu">
        <field name="action" ref="wati_connector.action_wati_workspace"/>
    </record>

    <menuitem
        id="menu_wati_home"
        name="الرئيسية"
        parent="wati_connector.menu_wati_root"
        action="wati_connector.action_wati_workspace"
        sequence="1"
    />

    <menuitem
        id="menu_wati_help"
        name="مركز المساعدة"
        parent="wati_connector.menu_wati_root"
        action="wati_connector.action_wati_help_center"
        sequence="95"
    />

    <menuitem
        id="menu_wati_settings"
        name="الإعدادات"
        parent="wati_connector.menu_wati_root"
        action="wati_connector.action_wati_settings"
        groups="base.group_system"
        sequence="100"
    />
</odoo>
