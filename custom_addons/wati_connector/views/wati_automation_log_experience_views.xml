<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_log_list_experience" model="ir.ui.view">
        <field name="name">wati.automation.log.list.experience</field>
        <field name="model">wati.automation.log</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_log_list_guard"/>
        <field name="priority">210</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="سجل التشغيل" create="false" edit="false" delete="false"
                      default_order="create_date desc"
                      decoration-success="ui_state in ('delivered', 'read')"
                      decoration-info="ui_state in ('accepted', 'sent')"
                      decoration-danger="ui_state == 'failed'"
                      decoration-muted="ui_state == 'pending'">
                    <field name="create_date" string="الوقت"/>
                    <field name="ui_kind" string="النوع" widget="badge"
                           decoration-info="ui_kind == 'test'"
                           decoration-success="ui_kind == 'live'"/>
                    <field name="ui_state" string="الحالة" widget="badge"
                           decoration-success="ui_state in ('delivered', 'read')"
                           decoration-info="ui_state == 'sent'"
                           decoration-warning="ui_state == 'accepted'"
                           decoration-danger="ui_state == 'failed'"
                           decoration-muted="ui_state == 'pending'"/>
                    <field name="rule_id" string="الأتمتة"/>
                    <field name="res_name" string="السجل"/>
                    <field name="phone" string="المستلم"/>
                    <field name="template_name" string="القالب"/>
                    <field name="ui_summary" string="النتيجة"/>
                    <field name="ui_timeline" string="المسار" optional="hide"/>
                    <field name="triggered_by_id" string="شغّلها" optional="hide"/>
                    <field name="last_webhook_status" string="آخر تحديث WATI" optional="hide"/>
                    <field name="status" column_invisible="True"/>
                    <field name="delivery_status" column_invisible="True"/>
                    <field name="is_test" column_invisible="True"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="view_wati_automation_log_form_experience" model="ir.ui.view">
        <field name="name">wati.automation.log.form.experience</field>
        <field name="model">wati.automation.log</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_log_form_guard"/>
        <field name="priority">210</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="replace">
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted">نتيجة تشغيل WhatsApp</span>
                        <h1>
                            <field name="ui_state" widget="badge" nolabel="1"
                                   decoration-success="ui_state in ('delivered', 'read')"
                                   decoration-info="ui_state == 'sent'"
                                   decoration-warning="ui_state == 'accepted'"
                                   decoration-danger="ui_state == 'failed'"
                                   decoration-muted="ui_state == 'pending'"/>
                        </h1>
                        <div class="text-muted">
                            <field name="ui_summary" nolabel="1" readonly="1"/>
                        </div>
                    </div>

                    <group col="2" string="ماذا حدث؟">
                        <group>
                            <field name="ui_kind" string="نوع التشغيل" widget="badge" readonly="1"/>
                            <field name="rule_id" string="الأتمتة" readonly="1"/>
                            <field name="template_name" string="القالب" readonly="1"/>
                            <field name="create_date" string="وقت التشغيل" readonly="1"/>
                        </group>
                        <group>
                            <field name="res_name" string="السجل" readonly="1"/>
                            <field name="phone" string="رقم المستلم" readonly="1"/>
                            <field name="triggered_by_id" string="تم التشغيل بواسطة" readonly="1"/>
                            <field name="ui_timeline" string="مسار الرسالة" readonly="1"/>
                        </group>
                    </group>

                    <group string="متابعة التسليم">
                        <div class="alert alert-info" role="status" invisible="ui_state not in ('accepted', 'sent')">
                            <strong>الطلب ناجح حتى الآن.</strong>
                            WATI استلم الرسالة، وسيتم تحديث هذه الصفحة تلقائيًا عند وصول Webhook للتسليم أو القراءة.
                        </div>
                        <div class="alert alert-success" role="status" invisible="ui_state not in ('delivered', 'read')">
                            <strong>تمت العملية بنجاح.</strong>
                            حالة الرسالة مؤكدة من تحديثات WATI.
                        </div>
                        <div class="alert alert-danger" role="alert" invisible="not ui_has_error">
                            <strong>تعذر إكمال الإرسال.</strong>
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </div>
                        <group col="4">
                            <field name="accepted_at" string="قُبل لدى WATI" readonly="1"/>
                            <field name="sent_at" string="تم الإرسال" readonly="1"/>
                            <field name="delivered_at" string="تم التسليم" readonly="1"/>
                            <field name="read_at" string="تمت القراءة" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="تفاصيل تقنية" groups="base.group_system">
                            <group col="2">
                                <group>
                                    <field name="status" readonly="1"/>
                                    <field name="delivery_status" readonly="1"/>
                                    <field name="last_webhook_status" readonly="1"/>
                                    <field name="last_webhook_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="external_message_id" readonly="1"/>
                                    <field name="broadcast_name" readonly="1"/>
                                    <field name="model_name" readonly="1"/>
                                    <field name="res_id" readonly="1"/>
                                </group>
                            </group>
                            <group string="استجابة WATI الخام" invisible="not response_excerpt">
                                <field name="response_excerpt" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </xpath>
        </field>
    </record>

    <record id="view_wati_automation_log_search_experience" model="ir.ui.view">
        <field name="name">wati.automation.log.search.experience</field>
        <field name="model">wati.automation.log</field>
        <field name="arch" type="xml">
            <search string="ابحث في سجل التشغيل">
                <field name="rule_id" string="الأتمتة"/>
                <field name="res_name" string="السجل"/>
                <field name="phone" string="رقم المستلم"/>
                <field name="template_name" string="القالب"/>
                <separator/>
                <filter name="successful" string="ناجحة" domain="[('status', 'in', ('accepted', 'sent', 'delivered', 'read'))]"/>
                <filter name="delivered" string="تم التسليم" domain="[('status', 'in', ('delivered', 'read'))]"/>
                <filter name="failed" string="فشلت" domain="[('status', '=', 'failed')]"/>
                <filter name="test" string="تجريبية" domain="[('is_test', '=', True)]"/>
                <filter name="live" string="فعلية" domain="[('is_test', '=', False)]"/>
                <separator/>
                <filter name="group_rule" string="تجميع: الأتمتة" context="{'group_by': 'rule_id'}"/>
                <filter name="group_status" string="تجميع: الحالة" context="{'group_by': 'status'}"/>
                <filter name="group_template" string="تجميع: القالب" context="{'group_by': 'template_name'}"/>
                <filter name="group_day" string="تجميع: اليوم" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_wati_automation_logs" model="ir.actions.act_window">
        <field name="name">سجل التشغيل</field>
        <field name="search_view_id" ref="wati_connector.view_wati_automation_log_search_experience"/>
    </record>
</odoo>
