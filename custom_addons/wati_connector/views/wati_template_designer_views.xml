<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_template_form_designer" model="ir.ui.view">
        <field name="name">wati.template.form.designer</field>
        <field name="model">wati.template</field>
        <field name="inherit_id" ref="wati_connector.view_wati_template_form"/>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="replace">
                <sheet class="o_wati_template_designer">
                    <div class="o_wati_template_notice alert alert-info" role="status" invisible="source != 'wati'">
                        <i class="fa fa-cloud-download me-2" title="Imported from WATI"/>
                        <strong>Template imported from WATI.</strong>
                        This copy mirrors the actual WATI/Meta template. Use “Create a new copy” if you want to edit the content.
                    </div>
                    <div class="o_wati_template_notice alert alert-danger" role="alert" invisible="status != 'rejected' or not rejection_reason">
                        <i class="fa fa-exclamation-triangle me-2" title="Meta rejected"/>
                        <strong>Meta rejected this template:</strong>
                        <field name="rejection_reason" class="d-inline"/>
                    </div>
                    <div class="o_wati_template_notice alert alert-danger" role="alert" invisible="not last_error">
                        <i class="fa fa-bug me-2" title="Provider error"/>
                        <strong>Provider error:</strong>
                        <field name="last_error" class="d-inline"/>
                    </div>

                    <div class="o_wati_template_designer_grid">
                        <main class="o_wati_template_editor">
                            <section class="o_wati_template_section o_wati_template_intro">
                                <div>
                                    <span class="o_wati_template_eyebrow">WHATSAPP TEMPLATE</span>
                                    <h1>Create a WhatsApp template</h1>
                                    <p>Build the message visually, preview it on mobile, then submit it to WATI and Meta.</p>
                                </div>
                                <div class="o_wati_template_state">
                                    <span class="o_wati_template_state_label">Current status</span>
                                    <field name="status" widget="badge" class="o_wati_template_state_badge"/>
                                </div>
                            </section>

                            <section class="o_wati_template_section">
                                <div class="o_wati_template_section_title">
                                    <div class="o_wati_template_step">1</div>
                                    <div><h2>Template data</h2><p>Select name, category and language.</p></div>
                                </div>
                                <div class="o_wati_template_identity_grid">
                                    <div class="o_wati_template_field"><label for="name">Template name</label><field name="name" placeholder="order_ready_ar" readonly="status != 'draft' or source != 'odoo'"/><small>Spaces and dashes automatically convert to (_). Example: order_ready_ar.</small></div>
                                    <div class="o_wati_template_field"><label for="category">Category</label><field name="category" readonly="status != 'draft' or source != 'odoo'"/><small>Utility for service messages, Marketing for marketing messages.</small></div>
                                    <div class="o_wati_template_field"><label for="language">Language</label><field name="language" placeholder="ar" readonly="status != 'draft' or source != 'odoo'"/><small>Example: ar for Arabic or en for English.</small></div>
                                </div>
                            </section>

                            <section class="o_wati_template_section">
                                <div class="o_wati_template_section_title"><div class="o_wati_template_step">2</div><div><h2>Template type</h2><p>Choose the message format. Your selection is saved with the draft.</p></div></div>
                                <field name="template_kind" widget="radio" options="{'horizontal': true}" class="o_wati_template_card_radio o_wati_template_kind_radio" readonly="status != 'draft' or source != 'odoo'" nolabel="1"/>
                                <div class="alert alert-warning o_wati_template_advanced_notice" role="status" invisible="not advanced_kind_notice"><i class="fa fa-info-circle me-2" title="Advanced type alert"/><field name="advanced_kind_notice" readonly="1" class="d-inline"/></div>
                                <field name="sub_category" invisible="1"/>
                            </section>

                            <section class="o_wati_template_section">
                                <div class="o_wati_template_section_title"><div class="o_wati_template_step">3</div><div><h2>Message header <span>Optional</span></h2><p>Choose no header, text, image, video or document.</p></div></div>
                                <field name="builder_header_type" widget="radio" options="{'horizontal': true}" class="o_wati_template_card_radio o_wati_template_header_radio" readonly="status != 'draft' or source != 'odoo'" nolabel="1"/>
                                <div class="o_wati_template_component_fields" invisible="builder_header_type == 'NONE'">
                                    <div class="o_wati_template_field" invisible="builder_header_type != 'TEXT'"><label for="builder_header_text">Header text</label><field name="builder_header_text" placeholder="Example: Order status update" readonly="status != 'draft' or source != 'odoo'"/><small>Maximum 60 characters.</small></div>
                                    <div class="o_wati_template_field" invisible="builder_header_type not in ['IMAGE', 'VIDEO', 'DOCUMENT']"><label for="header_media_url">Media link</label><field name="header_media_url" placeholder="https://example.com/media/file" readonly="status != 'draft' or source != 'odoo'"/><small>Use a direct URL that WATI can access.</small></div>
                                    <div class="o_wati_template_field" invisible="builder_header_type != 'DOCUMENT'"><label for="header_media_filename">Document file name</label><field name="header_media_filename" placeholder="invoice.pdf" readonly="status != 'draft' or source != 'odoo'"/></div>
                                </div>
                            </section>

                            <section class="o_wati_template_section o_wati_template_message_section">
                                <div class="o_wati_template_section_title">
                                    <div class="o_wati_template_step">4</div>
                                    <div><h2>Message text</h2><p>Write naturally. Variables are detected automatically while you type.</p></div>
                                    <div class="o_wati_template_counter">max 1024 characters</div>
                                </div>
                                <div class="o_wati_variable_helper" invisible="status != 'draft' or source != 'odoo'">
                                    <div class="o_wati_variable_helper_icon"><i class="fa fa-magic" title="Smart variables"/></div>
                                    <div class="o_wati_variable_helper_copy">
                                        <strong>Smart variables</strong>
                                        <span>Type a meaningful variable anywhere in your message. Odoo detects it, creates the row below and keeps its position in sync automatically.</span>
                                    </div>
                                    <div class="o_wati_variable_examples" aria-label="Variable examples">
                                        <code>{{customer_name}}</code>
                                        <code>{{order_number}}</code>
                                        <code>{{appointment_date}}</code>
                                    </div>
                                </div>
                                <div class="o_wati_template_body_box">
                                    <field name="body" string="Message text" placeholder="Hello {{customer_name}}, your order {{order_number}} is ready." readonly="status != 'draft' or source != 'odoo'" nolabel="1"/>
                                </div>

                                <div class="o_wati_template_variables o_wati_smart_variables" invisible="not variable_count">
                                    <div class="o_wati_template_inline_title">
                                        <div>
                                            <div class="o_wati_variable_title_line"><h3>Detected variables</h3><span class="o_wati_variable_auto_badge"><i class="fa fa-bolt" title="Automatic"/> Auto-synced</span></div>
                                            <p>Add a realistic sample for Meta review. The customer preview uses these samples automatically.</p>
                                        </div>
                                        <span class="o_wati_variable_count_badge"><field name="variable_count" readonly="1"/> detected</span>
                                    </div>
                                    <div class="o_wati_variable_contract_note">
                                        <i class="fa fa-info-circle" title="Variable rule"/>
                                        <span>Variable names and order come from the message. To rename, add or remove one, edit it in the message text above.</span>
                                    </div>
                                    <field name="variable_ids" readonly="status != 'draft' or source != 'odoo'" nolabel="1" class="o_wati_variable_table">
                                        <list editable="bottom" create="false" delete="false">
                                            <field name="position" string="#" readonly="1"/>
                                            <field name="name" string="Variable" readonly="1"/>
                                            <field name="sample_value" string="Customer preview / Meta sample" required="1" placeholder="Enter a realistic example..."/>
                                        </list>
                                    </field>
                                    <div class="o_wati_variable_ready_hint">
                                        <i class="fa fa-check-circle" title="Preview ready"/>
                                        <span>Samples are preview-only values. At send time, Automation can map each variable to real Odoo data.</span>
                                    </div>
                                </div>
                            </section>

                            <section class="o_wati_template_section">
                                <div class="o_wati_template_section_title"><div class="o_wati_template_step">5</div><div><h2>Footer <span>Optional</span></h2><p>Short text below the message, maximum 60 characters.</p></div></div>
                                <field name="footer" placeholder="Example: Thank you for using our service" readonly="status != 'draft' or source != 'odoo'" nolabel="1"/>
                            </section>

                            <section class="o_wati_template_section">
                                <div class="o_wati_template_section_title"><div class="o_wati_template_step">6</div><div><h2>Buttons <span>Optional</span></h2><p>Choose a button type, then enter its details.</p></div></div>
                                <field name="builder_button_type" widget="radio" options="{'horizontal': true}" class="o_wati_template_card_radio o_wati_template_button_radio" readonly="status != 'draft' or source != 'odoo'" nolabel="1"/>
                                <div class="o_wati_template_component_fields" invisible="builder_button_type == 'NONE'">
                                    <div class="o_wati_template_field"><label for="builder_button_text">Button text</label><field name="builder_button_text" placeholder="Example: View order" readonly="status != 'draft' or source != 'odoo'"/><small>Maximum 20 characters.</small></div>
                                    <div class="o_wati_template_field" invisible="builder_button_type != 'URL'"><label for="builder_button_url">Website link</label><field name="builder_button_url" placeholder="https://example.com/order" readonly="status != 'draft' or source != 'odoo'"/></div>
                                    <div class="o_wati_template_field" invisible="builder_button_type != 'PHONE'"><label for="builder_button_phone">Contact number</label><field name="builder_button_phone" placeholder="+966500000000" readonly="status != 'draft' or source != 'odoo'"/></div>
                                </div>
                                <details class="o_wati_template_technical_details" invisible="buttons_json in [False, '', '[]']"><summary>Raw button data</summary><field name="buttons_json" widget="text" readonly="1" nolabel="1"/></details>
                            </section>

                            <section class="o_wati_template_section o_wati_template_provider_section" invisible="status == 'draft' and source == 'odoo'">
                                <div class="o_wati_template_section_title"><div class="o_wati_template_step"><i class="fa fa-check" title="Provider status"/></div><div><h2>Meta / WATI</h2><p>Provider status and synchronization details.</p></div></div>
                                <div class="o_wati_template_provider_grid"><div><span>Status</span><field name="status" widget="badge"/></div><div><span>Quality</span><field name="quality" widget="badge"/></div><div><span>Last sync</span><field name="last_synced_at"/></div><div><span>Submitted</span><field name="submitted_at"/></div></div>
                                <details class="o_wati_template_technical_details"><summary>Provider identifiers</summary><div class="o_wati_template_provider_grid mt-3"><div><span>WATI Template ID</span><field name="wati_template_id"/></div><div><span>Meta Template ID</span><field name="meta_template_id"/></div><div><span>WABA ID</span><field name="waba_id"/></div><div><span>WhatsApp channel</span><field name="channel_phone_number"/></div></div></details>
                            </section>

                            <details class="o_wati_template_technical_details" groups="base.group_system"><summary>Administrator technical details</summary><div class="o_wati_template_technical_payloads"><field name="provider_request" widget="text"/><field name="provider_response" widget="text"/><field name="last_error" widget="text"/></div></details>
                        </main>

                        <aside class="o_wati_template_preview_panel">
                            <div class="o_wati_template_preview_sticky">
                                <div class="o_wati_template_preview_heading"><div><span>Live preview</span><strong>How will the message appear?</strong></div><i class="fa fa-whatsapp" title="WhatsApp"/></div>
                                <div class="o_wati_phone">
                                    <div class="o_wati_phone_topbar"><span>9:41</span><div><i class="fa fa-signal" title="Signal"/><i class="fa fa-wifi" title="Wi-Fi"/><i class="fa fa-battery-three-quarters" title="Battery"/></div></div>
                                    <div class="o_wati_phone_chat_header"><i class="fa fa-chevron-right" title="Back"/><div class="o_wati_phone_avatar"><i class="fa fa-whatsapp" title="WhatsApp"/></div><div><strong>WhatsApp Business</strong><span>Business account</span></div></div>
                                    <div class="o_wati_phone_chat">
                                        <div class="o_wati_phone_security">This conversation is protected by WhatsApp.</div>
                                        <div class="o_wati_message_bubble">
                                            <div class="o_wati_preview_media" invisible="builder_header_type not in ['IMAGE', 'VIDEO', 'DOCUMENT']"><field name="builder_header_preview" readonly="1" nolabel="1"/></div>
                                            <div class="o_wati_preview_header" invisible="builder_header_type != 'TEXT'"><field name="builder_header_preview" readonly="1" nolabel="1"/></div>
                                            <field name="preview_text" readonly="1" nolabel="1" class="o_wati_preview_body"/>
                                            <div class="o_wati_preview_footer" invisible="not footer"><field name="footer" readonly="1" nolabel="1"/></div>
                                            <div class="o_wati_preview_time">13:05 <i class="fa fa-check-double" title="Delivered"/></div>
                                        </div>
                                        <div class="o_wati_preview_buttons" invisible="builder_button_type == 'NONE'"><span><i class="fa fa-hand-pointer-o" title="Button"/><field name="builder_button_preview" readonly="1" class="d-inline"/></span></div>
                                    </div>
                                </div>
                                <div class="o_wati_template_preview_hint"><i class="fa fa-lightbulb-o" title="Information"/><span>The preview replaces variables with your sample values automatically.</span></div>
                            </div>
                        </aside>
                    </div>
                </sheet>
            </xpath>
        </field>
    </record>
</odoo>
