<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_rule_form_ux" model="ir.ui.view">
        <field name="name">wati.automation.rule.form.ux</field>
        <field name="model">wati.automation.rule</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_rule_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="replace">
                <header>
                    <button name="action_previous_step" type="object" string="Previous" icon="fa-arrow-right"
                            class="btn-secondary" invisible="setup_step == 'trigger'"/>
                    <field name="setup_step" widget="statusbar" statusbar_visible="trigger,recipient,message,review"/>
                    <button name="action_next_step" type="object" string="Next" icon="fa-arrow-left"
                            class="btn-primary" invisible="setup_step == 'review'"/>
                    <button name="action_activate_rule" type="object" string="Activate the rule" icon="fa-check-circle"
                            class="btn-success" invisible="setup_step != 'review' or active"/>
                    <button name="action_deactivate_rule" type="object" string="Off" icon="fa-pause"
                            class="btn-secondary" invisible="not active"/>
                </header>
            </xpath>

            <xpath expr="//form/sheet" position="replace">
                <sheet class="wati_auto_wizard">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="run_count" widget="statinfo" string="Operations"/>
                        </button>
                        <button name="action_duplicate_rule" type="object" class="oe_stat_button" icon="fa-copy">
                            <div class="o_stat_info"><span class="o_stat_text">Copy the rule</span></div>
                        </button>
                    </div>

                    <div class="oe_title wati_auto_title">
                        <label for="name" string="Rule name"/>
                        <h1><field name="name" placeholder="Example: Notifying the client when the opportunity qualifies"/></h1>
                    </div>

                    <div class="alert alert-primary wati_auto_summary" role="status">
                        <span class="fa fa-bolt me-2"/>
                        <field name="human_summary" readonly="1" nolabel="1"/>
                    </div>

                    <div class="wati_auto_step" invisible="setup_step != 'trigger'">
                        <div class="wati_auto_step_heading">
                            <span class="wati_auto_step_number">1</span>
                            <div>
                                <h2>When do we send the message?</h2>
                                <p>Select the application and event. You do not need any technical name or code.</p>
                            </div>
                        </div>

                        <group string="Start fast" col="2">
                            <field name="preset_key" placeholder="Optional: Choose a ready setting"/>
                            <button name="action_apply_preset" type="object" string="Ready setup application"
                                    icon="fa-magic" class="btn-secondary"/>
                        </group>

                        <group string="Event" col="2">
                            <group>
                                <field name="model_id" string="Application / Record type" options="{'no_create': True}"/>
                                <field name="trigger_field_id" string="What are we watching?" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="condition_operator" string="Condition"/>
                                <field name="target_value" string="Value" placeholder="Example: Qualified"
                                       invisible="condition_operator in ('is_set', 'is_not_set')"/>
                                <button name="action_pick_target_value" type="object" string="Choose from existing values"
                                        icon="fa-list" class="btn-link"
                                        invisible="condition_operator in ('is_set', 'is_not_set') or not trigger_field_id"/>
                            </group>
                        </group>

                        <div class="alert alert-light border" role="note">
                            <strong>Example:</strong> Choose CRM ← Stage ← equals ← Qualified. The system monitors the change itself after activation.
                        </div>
                    </div>

                    <div class="wati_auto_step" invisible="setup_step != 'recipient'">
                        <div class="wati_auto_step_heading">
                            <span class="wati_auto_step_number">2</span>
                            <div>
                                <h2>Who do we send to?</h2>
                                <p>Select the source of the WhatsApp number, or leave it to search automatically Odoo About the customer number.</p>
                            </div>
                        </div>

                        <group col="2">
                            <group string="Recipient number">
                                <field name="recipient_field_id" string="Telephone field" options="{'no_create': True}"/>
                                <field name="recipient_path" string="Linked path" placeholder="Example: partner_id.mobile"/>
                            </group>
                            <group string="Transmission policy">
                                <field name="once_per_record" string="Send once per record"/>
                                <field name="channel_number" string="Channel number WATI" placeholder="Optional; Uses settings WATI By default"/>
                            </group>
                        </group>

                        <div class="alert alert-info" role="note">
                            If you leave the number fields blank, the system will try automatically mobile Then phone Then the associated customer number.
                        </div>
                    </div>

                    <div class="wati_auto_step" invisible="setup_step != 'message'">
                        <div class="wati_auto_step_heading">
                            <span class="wati_auto_step_number">3</span>
                            <div>
                                <h2>What do we send?</h2>
                                <p>Choose a template WATI Then let the system fetch its variables and bind what it can automatically.</p>
                            </div>
                        </div>

                        <group col="2">
                            <group string="Template">
                                <field name="template_name" string="WATI Template" placeholder="Choose from WATI Or write the name"/>
                                <button name="action_pick_template" type="object" string="Choose a template from WATI"
                                        icon="fa-whatsapp" class="btn-primary"/>
                                <button name="action_fetch_template_params" type="object" string="Update template variables"
                                        icon="fa-refresh" class="btn-secondary" invisible="not template_name"/>
                            </group>
                            <group string="Template preview">
                                <field name="template_body" nolabel="1" readonly="1" placeholder="After selecting the template, its text will appear here, if any WATI Bring it back across API."/>
                            </group>
                        </group>

                        <div class="d-flex align-items-center justify-content-between mt-3 mb-2">
                            <h3 class="mb-0">Bind template variables to data Odoo</h3>
                            <button name="action_auto_map_parameters" type="object" string="Automatic smart link"
                                    icon="fa-magic" class="btn-secondary" invisible="not parameter_ids"/>
                        </div>
                        <field name="parameter_ids" nolabel="1">
                            <list editable="bottom" string="Template variables">
                                <field name="sequence" widget="handle"/>
                                <field name="param_name" string="variable WATI"/>
                                <field name="source_type" string="Source of value"/>
                                <field name="model_id" column_invisible="True"/>
                                <field name="source_field_id" string="Field Odoo" options="{'no_create': True}"
                                       invisible="source_type != 'field'"/>
                                <field name="source_path" string="Advanced path" placeholder="partner_id.name"
                                       invisible="source_type != 'field'" optional="hide"/>
                                <field name="static_value" string="Reserve value" placeholder="Used if the field value is empty"
                                       invisible="source_type in ('record_id', 'record_name')"/>
                                <field name="mapping_summary" string="Status" readonly="1"/>
                            </list>
                        </field>

                        <div class="alert alert-light border mt-3" role="note">
                            <strong>Smart connectivity</strong> Only obvious associations such as client name, record number, team and record name are suggested. Review any line on it ⚠️ Before activation.
                        </div>
                    </div>

                    <div class="wati_auto_step" invisible="setup_step != 'review'">
                        <div class="wati_auto_step_heading">
                            <span class="wati_auto_step_number">4</span>
                            <div>
                                <h2>Review and activate</h2>
                                <p>The system checks the connection, template and variables before allowing activation.</p>
                            </div>
                        </div>

                        <group col="2">
                            <group string="Readiness check">
                                <field name="readiness_state" widget="badge" readonly="1"
                                       decoration-success="readiness_state == 'ready'"
                                       decoration-warning="readiness_state == 'warning'"
                                       decoration-danger="readiness_state == 'incomplete'"/>
                                <field name="readiness_message" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Status">
                                <field name="active" readonly="1" widget="boolean_toggle"/>
                                <field name="success_count" readonly="1"/>
                                <field name="failure_count" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Preview on real data"/>
                        <div class="d-flex gap-2 mb-3">
                            <button name="action_preview_latest_record" type="object" string="Create a preview"
                                    icon="fa-eye" class="btn-secondary"/>
                        </div>
                        <group col="2" invisible="not preview_text">
                            <group>
                                <field name="preview_record_name" string="User record" readonly="1"/>
                            </group>
                            <group>
                                <field name="preview_text" string="Message format" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Secure test submission"/>
                        <div class="alert alert-warning" role="note">
                            Test sending uses real log data to populate variables, but sends the message to the test number below and not to the client.
                        </div>
                        <group col="2">
                            <field name="test_phone" string="Test number" placeholder="9665XXXXXXXX"/>
                            <button name="action_send_test" type="object" string="Submit a trial now"
                                    icon="fa-paper-plane" class="btn-secondary" invisible="not test_phone"/>
                        </group>

                        <notebook>
                            <page string="Technical details" groups="base.group_system">
                                <group>
                                    <field name="model_name" readonly="1"/>
                                    <field name="base_automation_id" readonly="1"/>
                                    <field name="server_action_id" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </div>
                </sheet>
            </xpath>
        </field>
    </record>

    <record id="view_wati_automation_rule_list_ux" model="ir.ui.view">
        <field name="name">wati.automation.rule.list.ux</field>
        <field name="model">wati.automation.rule</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_rule_list"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Rules WhatsApp" decoration-success="active" decoration-muted="not active">
                    <field name="sequence" widget="handle"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="name" string="The rule"/>
                    <field name="human_summary" string="What are you doing?"/>
                    <field name="template_name" string="Template"/>
                    <field name="readiness_state" string="Readiness" widget="badge"
                           decoration-success="readiness_state == 'ready'"
                           decoration-warning="readiness_state == 'warning'"
                           decoration-danger="readiness_state == 'incomplete'"/>
                    <field name="success_count" string="Successful"/>
                    <field name="failure_count" string="Failed"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="view_wati_automation_log_list_ux" model="ir.ui.view">
        <field name="name">wati.automation.log.list.ux</field>
        <field name="model">wati.automation.log</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_log_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="after">
                <field name="is_test" string="Demo" widget="boolean" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_wati_automation_log_form_ux" model="ir.ui.view">
        <field name="name">wati.automation.log.form.ux</field>
        <field name="model">wati.automation.log</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_log_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="after">
                <field name="is_test" string="Submit a test"/>
            </xpath>
        </field>
    </record>

    <record id="view_wati_automation_value_choice_list" model="ir.ui.view">
        <field name="name">wati.automation.value.choice.list</field>
        <field name="model">wati.automation.value.choice</field>
        <field name="arch" type="xml">
            <list string="Choose a value" create="false" edit="false" delete="false">
                <field name="label" string="Value"/>
                <field name="value" string="Internal value" optional="hide"/>
                <button name="action_select" type="object" string="Choice" icon="fa-check" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_wati_automation_template_choice_list" model="ir.ui.view">
        <field name="name">wati.automation.template.choice.list</field>
        <field name="model">wati.automation.template.choice</field>
        <field name="arch" type="xml">
            <list string="Templates WATI" create="false" edit="false" delete="false">
                <field name="name" string="Template"/>
                <field name="status" string="Status"/>
                <field name="category" string="Category" optional="show"/>
                <field name="body" string="Preview" optional="show"/>
                <button name="action_select" type="object" string="Use the template" icon="fa-check" class="btn-primary"/>
            </list>
        </field>
    </record>
</odoo>
