<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wati_smart_button" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wati.smart.button</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wati_connector.res_config_settings_view_form_wati"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='wati_smart_button_settings_slot']" position="replace">
                <block title="WhatsApp Smart Buttons &amp; Customer Timeline" name="wati_smart_button_settings">
                    <div class="wati-settings-note alert alert-info mb16" role="status">
                        <strong>Bring WhatsApp into any Odoo screen.</strong>
                        Add a WhatsApp action and customer conversation history without modifying the original Odoo application.
                    </div>

                    <div class="row g-3 wati-settings-card-grid">
                        <div class="col-12 col-xl-6">
                            <div class="wati-settings-card h-100">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="wati-settings-card-icon"><i class="fa fa-whatsapp" title="WhatsApp Smart Button"/></div>
                                    <div class="min-w-0">
                                        <h4 class="mb-1">WhatsApp Smart Buttons</h4>
                                        <p class="text-muted mb-0">Choose exactly where employees can open WhatsApp from an Odoo record.</p>
                                    </div>
                                </div>
                                <div class="small fw-bold mb-2">Setup in 3 simple steps</div>
                                <ol class="wati-settings-list text-muted mb-3 ps-3">
                                    <li>Choose the application and record type.</li>
                                    <li>Let smart discovery find the customer and mobile number.</li>
                                    <li>Activate the location — the WhatsApp button appears automatically.</li>
                                </ol>
                                <button name="action_wati_manage_smart_buttons" type="object"
                                        string="Manage Smart Buttons" class="btn btn-primary" icon="fa-whatsapp"/>
                            </div>
                        </div>

                        <div class="col-12 col-xl-6">
                            <div class="wati-settings-card h-100">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="wati-settings-card-icon"><i class="fa fa-history" title="Customer Timeline"/></div>
                                    <div class="min-w-0">
                                        <h4 class="mb-1">Customer WhatsApp Timeline</h4>
                                        <p class="text-muted mb-0">Keep the customer's WhatsApp history available from the same Odoo workflow.</p>
                                    </div>
                                </div>
                                <div class="small fw-bold mb-2">What employees can see</div>
                                <ul class="wati-settings-list text-muted mb-0">
                                    <li>Incoming and outgoing WhatsApp messages.</li>
                                    <li>Delivery/read status and the responsible employee.</li>
                                    <li>Conversation history linked automatically when the customer is detected.</li>
                                </ul>
                                <div class="alert alert-light border mt-3 mb-0 py-2">
                                    <i class="fa fa-link me-1"/> Smart Buttons and Timeline use the same customer mapping, so setup stays in one place.
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
