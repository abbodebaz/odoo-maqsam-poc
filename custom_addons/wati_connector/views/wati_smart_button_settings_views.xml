<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wati_smart_button" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wati.smart.button</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wati_connector.res_config_settings_view_form_wati"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='wati_smart_button_settings_slot']" position="replace">
                <block title="زر WhatsApp الذكي وسجل العميل" name="wati_smart_button_settings">
                    <div class="wati-settings-note alert alert-info mb16" role="status">
                        <strong>تحكم من مكان واحد.</strong>
                        أضف زر WhatsApp وسجل العميل إلى الشاشات التي تختارها داخل Odoo بدون تعديل التطبيقات الأصلية.
                    </div>

                    <div class="row g-3 wati-settings-card-grid">
                        <div class="col-12 col-xl-6">
                            <div class="wati-settings-card h-100">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="wati-settings-card-icon">
                                        <i class="fa fa-whatsapp" title="WhatsApp"/>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="mb-1">أماكن ظهور زر WhatsApp</h4>
                                        <p class="text-muted mb-0">حدد الشاشات التي يظهر فيها زر الإرسال وسجل WhatsApp.</p>
                                    </div>
                                </div>

                                <ul class="wati-settings-list text-muted mb-3">
                                    <li>اختر التطبيق والموديل المطلوب.</li>
                                    <li>حدد حقل رقم الجوال أو استخدم الاكتشاف الذكي.</li>
                                    <li>يمكن تفعيل أكثر من شاشة في نفس الوقت.</li>
                                </ul>

                                <button name="action_wati_manage_smart_buttons"
                                        type="object"
                                        string="إدارة أماكن زر WhatsApp"
                                        class="btn btn-primary"
                                        icon="fa-whatsapp"/>
                            </div>
                        </div>

                        <div class="col-12 col-xl-6">
                            <div class="wati-settings-card h-100">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="wati-settings-card-icon">
                                        <i class="fa fa-history" title="WhatsApp Timeline"/>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="mb-1">Customer WhatsApp Timeline</h4>
                                        <p class="text-muted mb-0">اعرض تاريخ WhatsApp من نفس شاشة العمل الحالية.</p>
                                    </div>
                                </div>

                                <ul class="wati-settings-list text-muted mb-0">
                                    <li>يعرض الرسائل الواردة والصادرة وحالتها.</li>
                                    <li>يعتمد على العميل المرتبط أو رقم الجوال.</li>
                                    <li>بطاقة العميل تحتفظ بالـTimeline الكامل تلقائيًا.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
