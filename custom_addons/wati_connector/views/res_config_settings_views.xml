<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wati" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wati</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="WATI WhatsApp" name="wati_connector" data-string="WATI WhatsApp">
                    <div class="wati-settings-intro alert alert-light border mb-3" role="status">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-whatsapp fa-lg text-success" title="WhatsApp"/>
                            <div class="min-w-0">
                                <strong>إعدادات WATI WhatsApp</strong>
                                <div class="text-muted">إعدادات مرتبة حسب الوظيفة للوصول السريع بدون تشتيت.</div>
                            </div>
                        </div>
                    </div>

                    <notebook name="wati_settings_notebook" class="wati_settings_notebook">
                        <page string="🔌 الاتصال و WATI" name="wati_settings_connection">
                            <block title="WATI API" name="wati_api_settings">
                                <setting string="الاتصال بـ WATI" help="بيانات الربط الأساسية مع WATI API." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <div class="mb-3">
                                            <label for="wati_api_endpoint" class="o_light_label d-block mb-1"/>
                                            <field name="wati_api_endpoint" placeholder="https://live-mt-server.wati.io/xxxxxx" class="w-100"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="wati_api_token" class="o_light_label d-block mb-1"/>
                                            <field name="wati_api_token" password="True" class="w-100"/>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <button name="action_wati_test_connection" type="object" string="اختبار الاتصال" class="btn btn-primary"/>
                                            <span class="text-muted small">الـToken محفوظ في Backend Odoo ولا يظهر للمتصفح.</span>
                                        </div>
                                    </div>
                                </setting>
                            </block>

                            <block title="Webhook والاستقبال" name="wati_webhook_settings">
                                <setting string="Webhook الوارد" help="استقبال رسائل العملاء وتحديثات الرسائل والقوالب." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <div class="mb-3">
                                            <label for="wati_webhook_token" class="o_light_label d-block mb-1"/>
                                            <field name="wati_webhook_token" password="True" placeholder="ضع نصًا سريًا طويلًا" class="w-100"/>
                                        </div>
                                        <div class="mb-2">
                                            <label for="wati_webhook_url" class="o_light_label d-block mb-1"/>
                                            <field name="wati_webhook_url" readonly="1" class="w-100"/>
                                        </div>
                                        <div class="text-muted small wati-helper-text">
                                            انسخ الرابط كما هو إلى WATI، ثم فعّل أحداث الرسائل والقوالب والجودة والتصنيف.
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </page>

                        <page string="👥 الصلاحيات" name="wati_settings_access">
                            <block title="صلاحيات مساحة WhatsApp" name="wati_workspace_access_settings">
                                <div class="wati-settings-note alert alert-info mb16" role="status">
                                    <strong>تحكم مركزي بالصلاحيات.</strong>
                                    اختر من يستطيع الوصول لكل جزء. خيار «مشرف WhatsApp فقط» يعتمد على دور <strong>WATI Administrator</strong> بدون منح صلاحيات مدير Odoo الكاملة.
                                </div>

                                <setting string="سجل المحادثات" help="الوصول إلى سجل المحادثات التاريخي." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <field name="wati_access_conversations" class="w-100"/>
                                        <div class="text-muted small mt8">اجعله متاحًا لفريق الخدمة أو للمشرفين فقط.</div>
                                    </div>
                                </setting>

                                <setting string="سجل الرسائل" help="الوصول إلى جميع الرسائل الواردة والصادرة." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <field name="wati_access_messages" class="w-100"/>
                                        <div class="text-muted small mt8">صندوق الوارد اليومي لا يتأثر بهذا الخيار.</div>
                                    </div>
                                </setting>

                                <setting string="مركز القوالب" help="إنشاء القوالب ومزامنتها وإرسالها للمراجعة." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <field name="wati_access_templates" class="w-100"/>
                                        <div class="text-muted small mt8">يفضل قصره على المشرفين.</div>
                                    </div>
                                </setting>

                                <setting string="مركز الأتمتة" help="إنشاء الأتمتات وتعديلها وتفعيلها." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <field name="wati_access_automation" class="w-100"/>
                                        <div class="text-muted small mt8">أي تعديل هنا قد يغيّر سلوك الإرسال التلقائي.</div>
                                    </div>
                                </setting>

                                <setting string="سجل التشغيل" help="مراجعة نتائج الأتمتة وأخطاء الإرسال." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <field name="wati_access_automation_logs" class="w-100"/>
                                        <div class="text-muted small mt8">مناسب للمشرف أو فريق الجودة.</div>
                                    </div>
                                </setting>

                                <setting string="مراقبة Webhook" help="مراجعة الـCallbacks وحالات المعالجة." class="wati-setting-item">
                                    <div class="content-group wati-setting-content">
                                        <field name="wati_access_monitor" class="w-100"/>
                                        <div class="text-muted small mt8">ميزة تشغيلية متقدمة للمشرفين.</div>
                                    </div>
                                </setting>
                            </block>
                        </page>

                        <page string="💬 صندوق الوارد" name="wati_settings_inbox">
                            <block title="ميزات صندوق الوارد" name="wati_inbox_feature_settings">
                                <setting string="المحادثات السريعة داخل Odoo"
                                         help="فعّل لإظهار نافذة WhatsApp المصغّرة من أي شاشة، أو عطّل لإخفائها."
                                         class="wati-setting-item">
                                    <field name="wati_enable_mini_inbox"/>
                                </setting>

                                <setting string="الأزرار التفاعلية"
                                         help="فعّل لإظهار أداة الأزرار التفاعلية داخل صندوق الوارد، أو عطّل لإخفائها من الواجهة."
                                         class="wati-setting-item">
                                    <field name="wati_enable_interactive_buttons"/>
                                </setting>

                                <setting string="القوائم التفاعلية"
                                         help="فعّل لإظهار أداة القوائم التفاعلية داخل صندوق الوارد، أو عطّل لإخفائها من الواجهة."
                                         class="wati-setting-item">
                                    <field name="wati_enable_interactive_lists"/>
                                </setting>
                            </block>
                        </page>

                        <page string="⚡ الأزرار وسجل العميل" name="wati_settings_smart">
                            <div id="wati_smart_button_settings_slot"/>
                        </page>
                    </notebook>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
