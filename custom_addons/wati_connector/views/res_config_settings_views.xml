<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wati" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wati</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="WATI WhatsApp" name="wati_connector" data-string="WATI WhatsApp">
                    <block title="WATI API" name="wati_api_settings">
                        <setting string="API Connection" help="بيانات الربط مع WATI API. الـToken يبقى في Backend Odoo ولا يتم كشفه للمتصفح.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="wati_api_endpoint" class="col-lg-3 o_light_label"/>
                                    <field name="wati_api_endpoint" placeholder="https://live-mt-server.wati.io/xxxxxx" class="col-lg-7"/>
                                </div>
                                <div class="row mt16">
                                    <label for="wati_api_token" class="col-lg-3 o_light_label"/>
                                    <field name="wati_api_token" password="True" class="col-lg-7"/>
                                </div>
                                <div class="row mt16">
                                    <div class="col-lg-3"/>
                                    <div class="col-lg-7">
                                        <button name="action_wati_test_connection" type="object" string="اختبار الاتصال بـ WATI" class="btn btn-primary"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting string="Incoming Webhook" help="يستقبل رسائل العملاء وحالات الرسائل وتحديثات القوالب من WATI داخل Odoo.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="wati_webhook_token" class="col-lg-3 o_light_label"/>
                                    <field name="wati_webhook_token" password="True" placeholder="ضع نصًا سريًا طويلًا" class="col-lg-7"/>
                                </div>
                                <div class="row mt16">
                                    <label for="wati_webhook_url" class="col-lg-3 o_light_label"/>
                                    <field name="wati_webhook_url" readonly="1" class="col-lg-7"/>
                                </div>
                                <div class="text-muted mt8">
                                    انسخ Webhook URL كاملًا كما هو إلى WATI. فعّل أحداث الرسائل وأحداث القوالب Template Reviewed / Quality / Category حتى تتحدث الحالات تلقائيًا.
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="صلاحيات مساحة WhatsApp" name="wati_workspace_access_settings">
                        <div class="alert alert-info mb16" role="status">
                            <strong>تحكم مركزي في ظهور الخدمات.</strong>
                            اختر من يستطيع استخدام كل جزء من مساحة WhatsApp. خيار «مشرفو WhatsApp فقط» يعتمد على دور
                            <strong>WATI Administrator</strong> داخل صلاحيات المستخدم، بدون الحاجة لمنح المستخدم صلاحيات مدير Odoo الكاملة.
                        </div>

                        <setting string="سجل المحادثات" help="إظهار شاشة سجل المحادثات التاريخية. صندوق الوارد اليومي يبقى مستقلًا عن هذا الخيار.">
                            <div class="content-group">
                                <field name="wati_access_conversations" class="w-50"/>
                                <div class="text-muted mt8">مناسب لخدمة العملاء إذا احتاجوا البحث التاريخي، أو اجعله للمشرفين فقط إذا أردت واجهة أبسط للموظفين.</div>
                            </div>
                        </setting>

                        <setting string="سجل الرسائل" help="تحديد من يستطيع فتح السجل الكامل للرسائل الواردة والصادرة.">
                            <div class="content-group">
                                <field name="wati_access_messages" class="w-50"/>
                                <div class="text-muted mt8">هذا الخيار يتحكم في شاشة السجل، بينما صندوق الوارد يستمر في عرض الرسائل اللازمة للعمل اليومي.</div>
                            </div>
                        </setting>

                        <setting string="مركز القوالب" help="تحديد من يستطيع إنشاء قوالب WhatsApp ومزامنتها وإرسالها إلى WATI/Meta للمراجعة.">
                            <div class="content-group">
                                <field name="wati_access_templates" class="w-50"/>
                                <div class="text-muted mt8">ننصح بجعله للمشرفين فقط لأن إنشاء أو حذف قالب يؤثر مباشرة على الأصول المعتمدة في WhatsApp Business.</div>
                            </div>
                        </setting>

                        <setting string="مركز الأتمتة" help="تحديد من يستطيع إنشاء وتعديل وتفعيل أتمتات WhatsApp.">
                            <div class="content-group">
                                <field name="wati_access_automation" class="w-50"/>
                                <div class="text-muted mt8">ننصح بإبقائه للمشرفين فقط في بيئة الشركات لأن أي تعديل هنا قد يغير سلوك الإرسال التلقائي.</div>
                            </div>
                        </setting>

                        <setting string="سجل التشغيل" help="تحديد من يستطيع مراجعة نتائج تشغيل الأتمتات وأخطاء الإرسال.">
                            <div class="content-group">
                                <field name="wati_access_automation_logs" class="w-50"/>
                                <div class="text-muted mt8">مفيد للمديرة أو فريق الجودة لمتابعة ما تم تشغيله بدون كشف التفاصيل التقنية لباقي الموظفين.</div>
                            </div>
                        </setting>

                        <setting string="مراقبة Webhook" help="تحديد من يستطيع فتح مركز مراقبة تكامل WATI والـCallbacks وحالات المعالجة.">
                            <div class="content-group">
                                <field name="wati_access_monitor" class="w-50"/>
                                <div class="text-muted mt8">ميزة تشغيلية متقدمة؛ الوضع الافتراضي يجعلها لمشرفي WhatsApp فقط.</div>
                            </div>
                        </setting>
                    </block>

                    <block title="ميزات صندوق الوارد" name="wati_inbox_feature_settings">
                        <setting string="المحادثات السريعة داخل Odoo" help="إظهار زر WhatsApp في شريط Odoo لفتح نافذة محادثات سريعة من أي شاشة، بدون مغادرة العمل الحالي.">
                            <field name="wati_enable_mini_inbox"/>
                        </setting>
                        <setting string="الأزرار التفاعلية" help="إظهار أداة «أزرار تفاعلية» لموظفي خدمة العملاء. عند الإيقاف تبقى الميزة موجودة في النظام لكنها لا تظهر في صندوق الوارد.">
                            <field name="wati_enable_interactive_buttons"/>
                        </setting>
                        <setting string="القوائم التفاعلية" help="إظهار أداة «قائمة تفاعلية» لموظفي خدمة العملاء. عند الإيقاف تبقى الميزة موجودة في النظام لكنها لا تظهر في صندوق الوارد.">
                            <field name="wati_enable_interactive_lists"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>