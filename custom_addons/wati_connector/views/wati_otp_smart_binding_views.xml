<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_otp_flow_smart_binding_fields" model="ir.ui.view">
        <field name="name">wati.otp.flow.smart.binding.fields</field>
        <field name="model">wati.otp.flow</field>
        <field name="inherit_id" ref="wati_connector.view_wati_otp_flow_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='binding_ids']/list/field[@name='field_path']" position="before">
                <field name="smart_target_metadata" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='binding_ids']/list/field[@name='field_path']" position="attributes">
                <attribute name="widget">wati_smart_target</attribute>
                <attribute name="placeholder">Choose Odoo field</attribute>
            </xpath>
        </field>
    </record>
</odoo>
