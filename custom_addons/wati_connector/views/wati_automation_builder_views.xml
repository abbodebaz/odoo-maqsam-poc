<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_rule_form_builder" model="ir.ui.view">
        <field name="name">wati.automation.rule.form.builder</field>
        <field name="model">wati.automation.rule</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_rule_form_ux"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="replace">
                <header class="wati_builder_header">
                    <field name="setup_step" widget="statusbar" statusbar_visible="trigger,recipient,message,review"/>
                    <button name="action_activate_rule" type="object" string="Activate the rule" icon="fa-check-circle"
                            class="btn-success" invisible="setup_step != 'review' or active"/>
                    <button name="action_deactivate_rule" type="object" string="Stop the rule" icon="fa-pause"
                            class="btn-secondary" invisible="not active"/>
                </header>
            </xpath>

            <xpath expr="//form/sheet" position="replace">
                <sheet class="wati_builder_sheet">
                    <div class="wati_builder_topbar">
                        <div class="wati_builder_title">
                            <span class="wati_builder_eyebrow">WhatsApp Automation</span>
                            <h1><field name="name" placeholder="Name automation, example: Message after qualifying the opportunity"/></h1>
                        </div>
                        <div class="wati_builder_top_actions">
                            <field name="readiness_state" widget="badge" readonly="1"
                                   decoration-success="readiness_state == 'ready'"
                                   decoration-warning="readiness_state == 'warning'"
                                   decoration-danger="readiness_state == 'incomplete'"/>
                            <button name="action_view_logs" type="object" string="Operations" icon="fa-list-alt" class="btn-secondary"/>
                            <button name="action_duplicate_rule" type="object" string="Copy" icon="fa-copy" class="btn-secondary"/>
                        </div>
                    </div>

                    <div class="wati_builder_layout">
                        <div class="wati_builder_main">
                            <div class="wati_builder_step" invisible="setup_step != 'trigger'">
                                <div class="wati_builder_step_head">
                                    <span class="wati_builder_step_no">1</span>
                                    <div>
                                        <h2>When does transmission start?</h2>
                                        <p>Choose a ready-made scenario or construct the event in one clear sentence.</p>
                                    </div>
                                </div>

                                <div class="wati_presets_section">
                                    <div class="wati_section_label">Start fast</div>
                                    <div class="wati_preset_grid">
                                        <button name="action_apply_named_preset" type="object"
                                                context="{'wati_preset_key': 'crm_qualified'}"
                                                class="wati_preset_card">
                                            <span class="wati_preset_app">CRM</span>
                                            <span class="wati_preset_text"><strong>Qualifying opportunity</strong><small>Stage → Qualified</small></span>
                                        </button>
                                        <button name="action_apply_named_preset" type="object"
                                                context="{'wati_preset_key': 'crm_won'}"
                                                class="wati_preset_card">
                                            <span class="wati_preset_app">CRM</span>
                                            <span class="wati_preset_text"><strong>Win the opportunity</strong><small>Stage → Won</small></span>
                                        </button>
                                        <button name="action_apply_named_preset" type="object"
                                                context="{'wati_preset_key': 'sale_confirmed'}"
                                                class="wati_preset_card">
                                            <span class="wati_preset_app">Sales</span>
                                            <span class="wati_preset_text"><strong>Confirm the order</strong><small>Order → Confirmed</small></span>
                                        </button>
                                        <button name="action_apply_named_preset" type="object"
                                                context="{'wati_preset_key': 'invoice_paid'}"
                                                class="wati_preset_card">
                                            <span class="wati_preset_app">Invoice</span>
                                            <span class="wati_preset_text"><strong>Pay the bill</strong><small>Payment → Paid</small></span>
                                        </button>
                                        <button name="action_start_custom_builder" type="object" class="wati_preset_card wati_preset_custom">
                                            <span class="wati_preset_app">+</span>
                                            <span class="wati_preset_text"><strong>Custom setup</strong><small>Build it the way you want</small></span>
                                        </button>
                                    </div>
                                    <field name="preset_key" invisible="1"/>
                                </div>

                                <div class="wati_trigger_builder">
                                    <div class="wati_section_label">Build the event</div>
                                    <div class="wati_trigger_sentence">
                                        <span class="wati_sentence_word">When</span>
                                        <div class="wati_sentence_field wati_sentence_model">
                                            <field name="model_id" nolabel="1" options="{'no_create': True, 'no_open': True}" placeholder="Select the application"/>
                                        </div>
                                        <span class="wati_sentence_arrow">←</span>
                                        <div class="wati_sentence_field">
                                            <field name="trigger_field_id" nolabel="1" options="{'no_create': True, 'no_open': True}" placeholder="Select field"/>
                                        </div>
                                        <div class="wati_sentence_field wati_sentence_operator">
                                            <field name="condition_operator" nolabel="1"/>
                                        </div>
                                        <div class="wati_sentence_field wati_sentence_value"
                                             invisible="condition_operator in ('is_set', 'is_not_set')">
                                            <field name="target_value" nolabel="1" placeholder="Value"/>
                                        </div>
                                        <button name="action_pick_target_value" type="object" string="Choose a value"
                                                icon="fa-chevron-down" class="wati_value_picker"
                                                invisible="condition_operator in ('is_set', 'is_not_set') or not trigger_field_id"/>
                                    </div>
                                </div>

                                <div class="wati_builder_hint">
                                    Example: <strong>CRM ← Stage ← equals ← Qualified</strong>. After activation, it will be monitored Odoo This change is automatic.
                                </div>

                                <div class="wati_builder_nav wati_builder_nav_single">
                                    <button name="action_next_step" type="object" string="Next: Recipient" icon="fa-arrow-left" class="btn-primary wati_builder_next"/>
                                </div>
                            </div>

                            <div class="wati_builder_step" invisible="setup_step != 'recipient'">
                                <div class="wati_builder_step_head">
                                    <span class="wati_builder_step_no">2</span>
                                    <div>
                                        <h2>To whom do we send the message?</h2>
                                        <p>In most cases you don’t need to prepare anything; The system can find the customer number automatically.</p>
                                    </div>
                                </div>

                                <div class="wati_recipient_cards">
                                    <div class="wati_recipient_card wati_recipient_card_active">
                                        <span class="wati_recipient_icon">✓</span>
                                        <div><strong>Customer number automatically</strong><small>Mobile → Phone → Associated client</small></div>
                                    </div>
                                    <div class="wati_recipient_card">
                                        <div class="wati_recipient_field_wrap">
                                            <span>Or choose a specific phone field</span>
                                            <field name="recipient_field_id" nolabel="1" options="{'no_create': True, 'no_open': True}"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="wati_policy_box">
                                    <field name="once_per_record" string="Send once per record"/>
                                    <p>It protects the client from repeating the same message if the log returns to the same stage again.</p>
                                </div>

                                <group string="Advanced settings" groups="base.group_system" class="wati_advanced_group">
                                    <field name="recipient_path" string="Linked number path" placeholder="partner_id.mobile"/>
                                    <field name="channel_number" string="Channel number WATI" placeholder="Optional"/>
                                </group>

                                <div class="wati_builder_nav">
                                    <button name="action_previous_step" type="object" string="Previous" icon="fa-arrow-right" class="btn-secondary"/>
                                    <button name="action_next_step" type="object" string="Next: The message" icon="fa-arrow-left" class="btn-primary wati_builder_next"/>
                                </div>
                            </div>

                            <div class="wati_builder_step" invisible="setup_step != 'message'">
                                <div class="wati_builder_step_head">
                                    <span class="wati_builder_step_no">3</span>
                                    <div>
                                        <h2>What message are we sending?</h2>
                                        <p>Choose template from WATI Then let the system fetch its variables and link the data automatically.</p>
                                    </div>
                                </div>

                                <div class="wati_template_picker_box">
                                    <div class="wati_template_field">
                                        <span class="wati_section_label">Template WATI</span>
                                        <field name="template_name" nolabel="1" placeholder="Choose a template"/>
                                    </div>
                                    <button name="action_pick_template" type="object" string="Choose from WATI" icon="fa-whatsapp" class="btn-primary"/>
                                    <button name="action_fetch_template_params" type="object" string="Update variables" icon="fa-refresh"
                                            class="btn-secondary" invisible="not template_name"/>
                                </div>

                                <div class="wati_template_preview" invisible="not template_body">
                                    <span class="wati_section_label">Template preview</span>
                                    <field name="template_body" nolabel="1" readonly="1"/>
                                </div>

                                <div class="wati_mapping_head">
                                    <div><h3>Data linking Odoo With the template</h3><p>We bind explicit variables automatically and you can edit any line.</p></div>
                                    <button name="action_auto_map_parameters" type="object" string="Smart linking" icon="fa-magic"
                                            class="btn-secondary" invisible="not parameter_ids"/>
                                </div>
                                <field name="parameter_ids" nolabel="1">
                                    <list editable="bottom" string="Template variables">
                                        <field name="sequence" widget="handle"/>
                                        <field name="param_name" string="variable WATI"/>
                                        <field name="source_type" string="Source of value"/>
                                        <field name="model_id" column_invisible="True"/>
                                        <field name="source_field_id" string="Data Odoo" options="{'no_create': True}"
                                               invisible="source_type != 'field'"/>
                                        <field name="source_path" string="Advanced path" optional="hide" invisible="source_type != 'field'"/>
                                        <field name="static_value" string="Reserve value" invisible="source_type in ('record_id', 'record_name')"/>
                                        <field name="mapping_summary" string="Status" readonly="1"/>
                                    </list>
                                </field>

                                <div class="wati_builder_nav">
                                    <button name="action_previous_step" type="object" string="Previous" icon="fa-arrow-right" class="btn-secondary"/>
                                    <button name="action_next_step" type="object" string="Next: Review" icon="fa-arrow-left" class="btn-primary wati_builder_next"/>
                                </div>
                            </div>

                            <div class="wati_builder_step" invisible="setup_step != 'review'">
                                <div class="wati_builder_step_head">
                                    <span class="wati_builder_step_no">4</span>
                                    <div>
                                        <h2>Review it and activate it</h2>
                                        <p>Before actual operation, we review the connection, template, and variables, and then we can try on a secure number.</p>
                                    </div>
                                </div>

                                <div class="wati_readiness_card">
                                    <div class="wati_readiness_title">
                                        <strong>Readiness check</strong>
                                        <field name="readiness_state" widget="badge" readonly="1"
                                               decoration-success="readiness_state == 'ready'"
                                               decoration-warning="readiness_state == 'warning'"
                                               decoration-danger="readiness_state == 'incomplete'"/>
                                    </div>
                                    <field name="readiness_message" nolabel="1" readonly="1"/>
                                </div>

                                <div class="wati_review_grid">
                                    <div class="wati_review_card">
                                        <span class="wati_section_label">Preview on real data</span>
                                        <button name="action_preview_latest_record" type="object" string="Create a preview" icon="fa-eye" class="btn-secondary"/>
                                        <field name="preview_record_name" string="Record" readonly="1" invisible="not preview_text"/>
                                        <field name="preview_text" string="The message" readonly="1" invisible="not preview_text"/>
                                    </div>
                                    <div class="wati_review_card">
                                        <span class="wati_section_label">Secure test submission</span>
                                        <p>It uses real data but sends to the test number only.</p>
                                        <field name="test_phone" nolabel="1" placeholder="9665XXXXXXXX"/>
                                        <button name="action_send_test" type="object" string="Submit an experience" icon="fa-paper-plane"
                                                class="btn-secondary" invisible="not test_phone"/>
                                    </div>
                                </div>

                                <notebook groups="base.group_system" class="wati_technical_notebook">
                                    <page string="Technical details">
                                        <group>
                                            <field name="model_name" readonly="1"/>
                                            <field name="base_automation_id" readonly="1"/>
                                            <field name="server_action_id" readonly="1"/>
                                        </group>
                                    </page>
                                </notebook>

                                <div class="wati_builder_nav">
                                    <button name="action_previous_step" type="object" string="Previous" icon="fa-arrow-right" class="btn-secondary"/>
                                    <button name="action_activate_rule" type="object" string="Activate automation" icon="fa-bolt"
                                            class="btn-success wati_builder_activate" invisible="active"/>
                                    <button name="action_deactivate_rule" type="object" string="Turn off automation" icon="fa-pause"
                                            class="btn-secondary" invisible="not active"/>
                                </div>
                            </div>
                        </div>

                        <div class="wati_builder_sidebar">
                            <div class="wati_workflow_card">
                                <div class="wati_workflow_card_head">
                                    <span>Automation summary</span>
                                    <field name="active" widget="boolean_toggle" readonly="1"/>
                                </div>

                                <div class="wati_flow_node">
                                    <span class="wati_flow_kicker">When it happens</span>
                                    <strong><field name="model_id" nolabel="1" readonly="1" options="{'no_open': True}"/></strong>
                                    <small><field name="trigger_field_id" nolabel="1" readonly="1" options="{'no_open': True}"/></small>
                                </div>
                                <div class="wati_flow_arrow">↓</div>
                                <div class="wati_flow_node wati_flow_whatsapp">
                                    <span class="wati_flow_kicker">Execute</span>
                                    <strong>Send WhatsApp</strong>
                                    <small><field name="template_name" nolabel="1" readonly="1"/></small>
                                </div>
                                <div class="wati_flow_arrow">↓</div>
                                <div class="wati_flow_node">
                                    <span class="wati_flow_kicker">To</span>
                                    <strong>Customer number</strong>
                                    <small invisible="not once_per_record">Once per record</small>
                                </div>

                                <div class="wati_workflow_sentence">
                                    <field name="human_summary" nolabel="1" readonly="1"/>
                                </div>
                            </div>

                            <div class="wati_sidebar_tip">
                                <strong>Without code</strong>
                                <p>After activating the rule, Odoo Monitors the event and sends the template from WATI Automatically.</p>
                            </div>
                        </div>
                    </div>
                </sheet>
            </xpath>
        </field>
    </record>
</odoo>
