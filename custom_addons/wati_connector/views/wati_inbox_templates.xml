<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="wati_inbox_page" name="WATI WhatsApp Inbox">
        <html lang="en" dir="ltr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow"/>
                <title>WhatsApp Inbox | Odoo</title>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/inbox.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/inbox_fix.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/media_enhance.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/attachment_send_v1.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/composer_v2.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/templates_v1.css"/>
                <t t-if="interactive_buttons_enabled">
                    <link rel="stylesheet" href="/wati_connector/static/src/inbox/interactive_buttons_v1.css?v=3"/>
                </t>
                <t t-if="interactive_lists_enabled">
                    <link rel="stylesheet" href="/wati_connector/static/src/inbox/interactive_list_v1.css?v=3"/>
                </t>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/font_tajawal_v1.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/contact_identity_v1.css"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/assignment_layout_fix_v1.css?v=3"/>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/conversation_actions_v1.css?v=3"/>
            </head>
            <body>
                <div id="watiInboxApp" class="wati-app" t-att-data-csrf="csrf_token">
                    <header class="wati-topbar">
                        <div class="wati-brand">
                            <div class="wati-logo">W</div>
                            <div>
                                <strong>WhatsApp Inbox</strong>
                                <span>WATI × Odoo</span>
                            </div>
                        </div>
                        <div class="wati-topbar-actions">
                            <span class="wati-agent">
                                <span class="wati-online-dot"></span>
                                <t t-esc="user_name"/>
                            </span>
                            <a class="wati-odoo-link" t-att-href="odoo_return_url">Back to Odoo</a>
                        </div>
                    </header>

                    <main class="wati-workspace">
                        <aside id="watiSidebar" class="wati-sidebar">
                            <div class="wati-sidebar-head">
                                <div>
                                    <h1>Conversations</h1>
                                    <p id="conversationCount">Loading...</p>
                                </div>
                                <button id="refreshButton" class="wati-icon-button" type="button" title="Refresh">↻</button>
                            </div>
                            <label class="wati-search">
                                <span>⌕</span>
                                <input id="conversationSearch" type="search" placeholder="Search by name or number..." autocomplete="off"/>
                            </label>
                            <div class="wati-filters">
                                <button class="wati-filter active" type="button" data-filter="all">All</button>
                                <button class="wati-filter" type="button" data-filter="mine">My Conversations</button>
                                <button class="wati-filter" type="button" data-filter="unassigned">Unassigned</button>
                                <button class="wati-filter" type="button" data-filter="unread">Unread</button>
                            </div>
                            <div id="conversationList" class="wati-conversation-list"></div>
                        </aside>

                        <section id="watiChat" class="wati-chat">
                            <div id="chatEmpty" class="wati-empty">
                                <div class="wati-empty-icon">💬</div>
                                <h2>Select a conversation</h2>
                                <p>Choose a customer from the list to view the conversation and reply.</p>
                            </div>

                            <div id="chatContent" class="wati-chat-content is-hidden">
                                <header class="wati-chat-head">
                                    <div class="wati-chat-person">
                                        <button id="mobileBack" class="wati-mobile-back" type="button">‹</button>
                                        <div id="chatAvatar" class="wati-avatar">W</div>
                                        <div>
                                            <h2 id="chatName">WhatsApp</h2>
                                            <div class="wati-chat-meta">
                                                <span id="chatNumber"></span>
                                                <span id="chatStatus" class="wati-status-badge"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="wati-chat-actions">
                                        <span id="assignmentBadge" class="wati-assignment-badge is-unassigned">Checking...</span>
                                        <button id="conversationActionsButton" class="wati-conversation-actions-button" type="button" aria-haspopup="dialog" aria-controls="conversationActionsDrawer" aria-expanded="false">
                                            <span class="wati-actions-label">Conversation Actions</span>
                                            <span class="wati-actions-dots" aria-hidden="true">⋯</span>
                                        </button>
                                    </div>
                                </header>

                                <div id="messageList" class="wati-message-list"></div>

                                <form id="messageForm" class="wati-composer">
                                    <textarea id="messageInput" name="message" rows="1" maxlength="4096" placeholder="Write a message..." required="required"></textarea>
                                    <button id="sendButton" type="submit">Send <span>➤</span></button>
                                </form>
                                <div class="wati-composer-note">Send free-form messages and attachments during the active WhatsApp session, or use Templates to send an approved WATI template.</div>
                            </div>
                        </section>
                    </main>

                    <div id="conversationActionsOverlay" class="wati-actions-overlay is-hidden" aria-hidden="true">
                        <aside id="conversationActionsDrawer" class="wati-actions-drawer" role="dialog" aria-modal="true" aria-labelledby="conversationActionsTitle">
                            <div class="wati-actions-drawer-head">
                                <div>
                                    <strong id="conversationActionsTitle">Conversation Actions</strong>
                                    <span>Assignment, WhatsApp tools, and conversation details</span>
                                </div>
                                <button id="conversationActionsClose" class="wati-actions-drawer-close" type="button" aria-label="Close">×</button>
                            </div>
                            <div class="wati-actions-drawer-body">
                                <section class="wati-actions-section">
                                    <h3>Assignment</h3>
                                    <div class="wati-actions-info-row">
                                        <span>Status</span>
                                        <strong id="drawerAssignmentStatus">Checking...</strong>
                                    </div>
                                    <div class="wati-actions-info-row">
                                        <span>Assigned Agent</span>
                                        <span id="drawerAssignedUser">—</span>
                                    </div>
                                    <div id="drawerAssignmentAction"></div>
                                </section>

                                <section class="wati-actions-section">
                                    <h3>Odoo Contact</h3>
                                    <div class="wati-actions-info-row">
                                        <span>Status</span>
                                        <strong id="drawerPartnerStatus">Checking...</strong>
                                    </div>
                                    <a id="drawerPartnerLink" class="wati-actions-inline-link is-hidden" href="#" target="_blank" rel="noopener noreferrer">Open Contact in Odoo</a>
                                </section>

                                <t t-if="interactive_buttons_enabled or interactive_lists_enabled">
                                    <section class="wati-actions-section">
                                        <h3>WhatsApp Tools</h3>
                                        <div class="wati-actions-tools">
                                            <t t-if="interactive_buttons_enabled">
                                                <button id="drawerInteractiveButtons" class="wati-actions-tool" type="button">▦ Interactive Buttons</button>
                                            </t>
                                            <t t-if="interactive_lists_enabled">
                                                <button id="drawerInteractiveList" class="wati-actions-tool" type="button">☷ Interactive List</button>
                                            </t>
                                        </div>
                                    </section>
                                </t>

                                <section class="wati-actions-section">
                                    <h3>Conversation Details</h3>
                                    <div class="wati-actions-info-row">
                                        <span>WhatsApp Number</span>
                                        <span id="drawerPhone">—</span>
                                    </div>
                                    <span id="chatOperator" class="is-hidden"></span>
                                </section>
                            </div>
                        </aside>
                    </div>

                    <div id="watiToast" class="wati-toast" role="status"></div>
                </div>
                <script src="/wati_connector/static/src/inbox/conversation_preselect.js" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/inbox.js" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/partner_enhance.js?v=3" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/assignment_takeover.js?v=3" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/media_enhance.js" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/attachment_send_v1.js" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/templates_v1.js" defer="defer"></script>
                <t t-if="interactive_buttons_enabled">
                    <script src="/wati_connector/static/src/inbox/interactive_buttons_v1.js?v=3" defer="defer"></script>
                </t>
                <t t-if="interactive_lists_enabled">
                    <script src="/wati_connector/static/src/inbox/interactive_list_v1.js?v=3" defer="defer"></script>
                </t>
                <script src="/wati_connector/static/src/inbox/conversation_actions_v1.js?v=3" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/ui_polish_v4.js" defer="defer"></script>
                <script src="/wati_connector/static/src/inbox/scroll_natural_v2.js" defer="defer"></script>
            </body>
        </html>
    </template>
</odoo>