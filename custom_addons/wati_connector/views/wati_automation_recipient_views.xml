<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_rule_form_smart_recipient" model="ir.ui.view">
        <field name="name">wati.automation.rule.form.smart.recipient</field>
        <field name="model">wati.automation.rule</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_rule_form_builder"/>
        <field name="priority">150</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('wati_builder_step')][@invisible=&quot;setup_step != 'recipient'&quot;]" position="replace">
                <div class="wati_builder_step" invisible="setup_step != 'recipient'">
                    <field name="smart_recipient_metadata" invisible="1"/>
                    <field name="recipient_field_id" invisible="1"/>

                    <div class="wati_builder_step_head">
                        <span class="wati_builder_step_no">2</span>
                        <div>
                            <h2>To whom do we send the message?</h2>
                            <p>Choose the method closest to you, and the system detects the phone fields and relationships in Odoo Automatically.</p>
                        </div>
                    </div>

                    <div class="wati_recipient_mode_box">
                        <span class="wati_section_label">How to choose the recipient number</span>
                        <field name="recipient_mode" widget="radio" options="{'horizontal': True}" nolabel="1"/>
                    </div>

                    <div class="wati_recipient_context" invisible="recipient_mode != 'auto'">
                        <div class="wati_recipient_context_icon">✓</div>
                        <div>
                            <strong>Let Odoo Choose the most appropriate number</strong>
                            <p>It will first search the obvious phone fields, then the associated records, without any technical setup on your part.</p>
                        </div>
                    </div>

                    <div class="wati_recipient_context" invisible="recipient_mode == 'auto'">
                        <div class="wati_recipient_context_icon">↳</div>
                        <div class="wati_recipient_select_wrap">
                            <strong invisible="recipient_mode != 'direct'">Choose a number from the same record</strong>
                            <strong invisible="recipient_mode != 'related'">Choose a number from a linked record</strong>
                            <p invisible="recipient_mode != 'direct'">We only display phone fields that are directly in the record type you chose.</p>
                            <p invisible="recipient_mode != 'related'">We show understandable paths such as: Associated client ← Mobile phone, without showing names Odoo Technology.</p>
                            <field name="recipient_path"
                                   widget="wati_smart_recipient"
                                   nolabel="1"
                                   placeholder="Choose the recipient number"/>
                        </div>
                    </div>

                    <div class="wati_recipient_preview">
                        <span class="wati_recipient_preview_icon">📱</span>
                        <div>
                            <strong>The message will be sent to</strong>
                            <field name="recipient_summary" nolabel="1" readonly="1"/>
                            <field name="recipient_preview_note" nolabel="1" readonly="1"/>
                        </div>
                    </div>

                    <div class="wati_policy_box wati_recipient_dedup">
                        <div class="wati_policy_title">Prevent recurrence</div>
                        <field name="once_per_record" string="Don’t send the same automation more than once to the same record"/>
                        <p>Useful if the record returns to the same condition or is modified multiple times after the condition is met.</p>
                    </div>

                    <details class="wati_recipient_advanced" groups="base.group_system">
                        <summary>Advanced settings</summary>
                        <div class="wati_recipient_advanced_body">
                            <group>
                                <field name="recipient_advanced_path"
                                       string="Custom number path"
                                       placeholder="partner_id.mobile"/>
                                <field name="channel_number"
                                       string="channel WATI Specific"
                                       placeholder="Optional"/>
                            </group>
                            <p>These options are for technical administrators only. In most cases you will not need to modify it.</p>
                        </div>
                    </details>

                    <div class="wati_builder_nav">
                        <button name="action_previous_step" type="object" string="Previous" icon="fa-arrow-right" class="btn-secondary"/>
                        <button name="action_next_step" type="object" string="Next: The message" icon="fa-arrow-left" class="btn-primary wati_builder_next"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
