<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_wati_webhook_attention" model="ir.actions.act_window">
        <field name="name">Events to Review</field>
        <field name="res_model">wati.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="wati_connector.view_wati_webhook_event_list_monitor"/>
        <field name="search_view_id" ref="wati_connector.view_wati_webhook_event_search_monitor"/>
        <field name="domain">[("processing_state", "=", "needs_attention")]</field>
        <field name="context">{"search_default_primary_callbacks": 1, "search_default_needs_attention": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No integration events need review</p>
            <p>Only callbacks tied to an Odoo-originated send and missing their expected local record appear here.</p>
        </field>
    </record>
</odoo>
