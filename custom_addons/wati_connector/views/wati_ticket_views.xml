<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_support_ticket_list" model="ir.ui.view">
        <field name="name">wati.support.ticket.list</field>
        <field name="model">wati.support.ticket</field>
        <field name="arch" type="xml">
            <list string="تذاكر خدمة العملاء">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_wati_support_ticket_form" model="ir.ui.view">
        <field name="name">wati.support.ticket.form</field>
        <field name="model">wati.support.ticket</field>
        <field name="arch" type="xml">
            <form string="تذكرة خدمة العملاء">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="new,in_progress,waiting,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1><field name="subject" placeholder="موضوع التذكرة..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="conversation_id"/>
                            <field name="wa_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="priority"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="اكتب تفاصيل المشكلة أو الطلب..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wati_support_tickets" model="ir.actions.act_window">
        <field name="name">التذاكر</field>
        <field name="res_model">wati.support.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_tickets': 0}</field>
    </record>

    <menuitem
        id="menu_wati_support_tickets"
        name="التذاكر"
        parent="wati_connector.menu_wati_root"
        action="action_wati_support_tickets"
        sequence="30"
    />
</odoo>
