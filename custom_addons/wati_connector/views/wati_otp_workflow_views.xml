<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_otp_flow_form_workflow" model="ir.ui.view">
        <field name="name">wati.otp.flow.form.workflow</field>
        <field name="model">wati.otp.flow</field>
        <field name="inherit_id" ref="wati_connector.view_wati_otp_flow_form"/>
        <field name="priority">280</field>
        <field name="arch" type="xml">
            <!-- Contextual help for the core OTP builder choices. -->
            <field name="app_menu_id" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>Application</strong>
                    <i class="fa fa-question-circle text-muted" title="Choose the Odoo application that contains the service or record you want to protect with OTP."/>
                </div>
            </field>
            <field name="app_menu_id" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="model_id" position="before">
                <div class="d-flex align-items-center gap-1 mb-1 mt-2">
                    <strong>Record type</strong>
                    <i class="fa fa-question-circle text-muted" title="Choose the exact Odoo record type the OTP flow will work with, for example Task, Lead, Ticket, or Service Completion Task."/>
                </div>
            </field>
            <field name="model_id" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="trigger_method" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>Trigger method</strong>
                    <i class="fa fa-question-circle text-muted" title="Manual action: an employee starts OTP from a button. When a field changes: Odoo sends OTP automatically when a field matches a condition. Integration hook: a custom module or button calls OTP Bridge programmatically."/>
                </div>
            </field>
            <field name="trigger_method" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="trigger_field_id" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>Trigger field</strong>
                    <i class="fa fa-question-circle text-muted" title="The field Odoo watches to decide when the OTP should be sent, for example Stage, Status, or Approval state."/>
                </div>
            </field>
            <field name="trigger_field_id" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="trigger_operator" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>Trigger condition</strong>
                    <i class="fa fa-question-circle text-muted" title="Choose how the trigger field should be evaluated: Equals checks a specific value, Has a value checks that it is not empty, and Is true checks a boolean field."/>
                </div>
            </field>
            <field name="trigger_operator" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="trigger_value" position="before">
                <div class="d-flex align-items-center gap-1 mb-1 mt-2" invisible="trigger_operator != 'equals'">
                    <strong>Condition value</strong>
                    <i class="fa fa-question-circle text-muted" title="Enter the visible value that should trigger OTP, for example Resolved, Approved, or Ready for Confirmation."/>
                </div>
            </field>
            <field name="trigger_value" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="recipient_mode" position="before">
                <div class="d-flex align-items-center gap-1 mb-2">
                    <strong>Recipient source</strong>
                    <i class="fa fa-question-circle text-muted" title="Automatic lets OTP Bridge find the best customer number. Phone from this record uses a phone field directly on the record. Phone from a related record follows a relation such as Task → Customer → Mobile."/>
                </div>
            </field>

            <field name="template_id" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>WATI template</strong>
                    <i class="fa fa-question-circle text-muted" title="Choose the approved WhatsApp template used to send this OTP. One template variable must be mapped to OTP Code."/>
                </div>
            </field>
            <field name="template_id" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="channel_number" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>WATI channel number</strong>
                    <i class="fa fa-question-circle text-muted" title="Optional. Use this only when this OTP flow must send from a specific WATI WhatsApp number. Leave it blank to use the normal/default channel."/>
                </div>
            </field>
            <field name="channel_number" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="code_length" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>OTP length</strong>
                    <i class="fa fa-question-circle text-muted" title="Number of digits generated for the OTP. Six digits is recommended for normal service confirmation."/>
                </div>
            </field>
            <field name="code_length" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="validity_minutes" position="before">
                <div class="d-flex align-items-center gap-1 mb-1 mt-2">
                    <strong>Validity period</strong>
                    <i class="fa fa-question-circle text-muted" title="How long the OTP remains valid after it is sent. After this time the customer must request a new code."/>
                </div>
            </field>
            <field name="validity_minutes" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="max_attempts" position="before">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <strong>Maximum attempts</strong>
                    <i class="fa fa-question-circle text-muted" title="How many incorrect verification attempts are allowed before the OTP transaction is locked."/>
                </div>
            </field>
            <field name="max_attempts" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="allow_resend" position="before">
                <div class="d-flex align-items-center gap-1 mb-1 mt-2">
                    <strong>Allow resend</strong>
                    <i class="fa fa-question-circle text-muted" title="Allow employees or the portal to send a replacement OTP if the customer did not receive the first code. The previous active code is invalidated."/>
                </div>
            </field>
            <field name="allow_resend" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <field name="resend_cooldown_seconds" position="before">
                <div class="d-flex align-items-center gap-1 mb-1 mt-2" invisible="not allow_resend">
                    <strong>Resend cooldown</strong>
                    <i class="fa fa-question-circle text-muted" title="Minimum time users must wait before requesting another OTP. This prevents accidental repeated messages."/>
                </div>
            </field>
            <field name="resend_cooldown_seconds" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>

            <!-- Manual button builder. -->
            <xpath expr="//field[@name='trigger_method']/ancestor::div[contains(@class, 'wati_otp_card')][1]" position="after">
                <div class="wati_otp_card wati_otp_manual_button_card" invisible="trigger_method != 'manual'">
                    <div class="wati_otp_card_title_row">
                        <div>
                            <h3>OTP button</h3>
                            <p class="text-muted mb-0">Choose exactly where employees should start this OTP flow.</p>
                        </div>
                        <span class="badge rounded-pill text-bg-light">Manual trigger</span>
                    </div>
                    <group>
                        <group>
                            <div class="d-flex align-items-center gap-1 mb-1">
                                <strong>Button location</strong>
                                <i class="fa fa-question-circle text-muted" title="Form header: a visible button at the top of the record. Smart button area: a compact button in the record's statistics/button box. Actions menu: an item inside Odoo's Actions menu."/>
                            </div>
                            <field name="manual_button_placement" widget="radio" options="{'horizontal': True}" nolabel="1"/>
                            <div class="d-flex align-items-center gap-1 mb-1 mt-2">
                                <strong>Button label</strong>
                                <i class="fa fa-question-circle text-muted" title="The text employees will see on the OTP button, for example Send OTP, Confirm customer, or Close with OTP."/>
                            </div>
                            <field name="manual_button_label" placeholder="Send OTP" nolabel="1"/>
                        </group>
                        <group>
                            <div class="d-flex align-items-center gap-1 mb-1" invisible="manual_button_placement == 'actions'">
                                <strong>Form screen</strong>
                                <i class="fa fa-question-circle text-muted" title="Choose the original Odoo form where the OTP button should be installed. OTP Bridge generated/inherited views are technical views and should not be selected."/>
                            </div>
                            <field name="manual_view_id"
                                   nolabel="1"
                                   options="{'no_create': True}"
                                   domain="[('model', '=', model_name), ('type', '=', 'form'), ('mode', '=', 'primary'), ('active', '=', True)]"
                                   invisible="manual_button_placement == 'actions'"/>
                            <field name="generated_manual_view_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="wati_otp_subcard">
                        <strong>Show button only when <span class="text-muted fw-normal">(optional)</span></strong>
                        <i class="fa fa-question-circle text-muted ms-1" title="Use this when the OTP button should appear only at a specific stage or status. Leave it empty to show the button on every record."/>
                        <p class="text-muted">Example: show Send OTP only when Stage equals Resolved.</p>
                        <group>
                            <group>
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <strong>Visibility field</strong>
                                    <i class="fa fa-question-circle text-muted" title="Choose the field that controls whether the OTP button is visible, for example Status or Stage."/>
                                </div>
                                <field name="manual_condition_field_id" options="{'no_create': True}" nolabel="1"/>
                            </group>
                            <group invisible="not manual_condition_field_id">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <strong>Button condition</strong>
                                    <i class="fa fa-question-circle text-muted" title="Equals shows the button only when the field matches a specific value. Has a value shows it whenever the field is not empty."/>
                                </div>
                                <field name="manual_condition_operator" nolabel="1"/>
                                <div class="d-flex align-items-center gap-1 mb-1 mt-2" invisible="manual_condition_operator != 'equals'">
                                    <strong>Condition value</strong>
                                    <i class="fa fa-question-circle text-muted" title="Enter the visible value users see in Odoo, for example Ready for Confirmation, Resolved, or Approved."/>
                                </div>
                                <field name="manual_condition_value"
                                       nolabel="1"
                                       invisible="manual_condition_operator != 'equals'"
                                       placeholder="Example: Resolved"/>
                            </group>
                        </group>
                    </div>
                    <div class="wati_otp_info mt-3">
                        <i class="fa fa-magic" title="Automatic setup"/>
                        <div>
                            <strong>Installed automatically</strong>
                            <span>When the flow is activated, OTP Bridge creates and maintains this button in the selected Odoo form.</span>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[contains(@class, 'wati_otp_info')][.//strong[normalize-space()='Manual service action']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='completion_mode']/ancestor::div[contains(@class, 'wati_otp_card')][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='completion_mode']/ancestor::div[contains(@class, 'wati_otp_card')][1]" position="after">
                <div class="wati_otp_card wati_otp_post_actions_card">
                    <div class="wati_otp_card_title_row">
                        <div>
                            <h3>After successful verification <i class="fa fa-question-circle text-muted" title="These actions run only after the customer enters the correct OTP. Add more than one action and Odoo will execute them from top to bottom."/></h3>
                            <p class="text-muted mb-0">Add one or more actions. Odoo runs them from top to bottom after the OTP is correct.</p>
                        </div>
                        <span class="badge rounded-pill text-bg-light">Multiple actions</span>
                    </div>
                    <div class="wati_otp_action_examples">
                        <span><i class="fa fa-exchange" title="Update"/> Update a field</span>
                        <span><i class="fa fa-whatsapp" title="WhatsApp"/> Send a WhatsApp template</span>
                        <span><i class="fa fa-bolt" title="Server action"/> Run a server action</span>
                    </div>
                    <field name="post_action_ids" nolabel="1" mode="list,form" context="{'default_flow_id': id}">
                        <list string="After verification actions">
                            <field name="sequence" widget="handle"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="name" string="Action"/>
                            <field name="action_type"/>
                        </list>
                    </field>
                    <div class="wati_otp_info mt-3">
                        <i class="fa fa-info-circle" title="Execution behavior"/>
                        <div>
                            <strong>The OTP remains verified even if a follow-up action fails.</strong>
                            <span>OTP Bridge records the follow-up result so the verification itself is never lost.</span>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_wati_otp_post_action_list" model="ir.ui.view">
        <field name="name">wati.otp.post.action.list</field>
        <field name="model">wati.otp.post.action</field>
        <field name="arch" type="xml">
            <list string="After verification actions">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="action_type"/>
                <field name="field_id" optional="hide"/>
                <field name="template_id" optional="hide"/>
                <field name="server_action_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wati_otp_post_action_form" model="ir.ui.view">
        <field name="name">wati.otp.post.action.form</field>
        <field name="model">wati.otp.post.action</field>
        <field name="arch" type="xml">
            <form string="After verification action">
                <sheet>
                    <field name="flow_id" invisible="1"/>
                    <field name="model_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" nolabel="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <div class="d-flex align-items-center gap-1 mb-1">
                                <strong>Action</strong>
                                <i class="fa fa-question-circle text-muted" title="Update an Odoo field changes data on the source record. Send a WhatsApp template sends a follow-up message. Run an Odoo server action executes an existing advanced Odoo workflow."/>
                            </div>
                            <field name="action_type" widget="radio" nolabel="1"/>
                        </group>
                    </group>

                    <div class="wati_otp_card" invisible="action_type != 'update_field'">
                        <h3>Update the Odoo record</h3>
                        <p class="text-muted">Example: Stage → Closed.</p>
                        <group>
                            <div class="d-flex align-items-center gap-1 mb-1"><strong>Field to update</strong><i class="fa fa-question-circle text-muted" title="Choose the field that should change after verification, for example Status or Stage."/></div>
                            <field name="field_id" options="{'no_create': True}" nolabel="1"/>
                            <div class="d-flex align-items-center gap-1 mb-1 mt-2"><strong>New value</strong><i class="fa fa-question-circle text-muted" title="Enter the visible value you want Odoo to set, for example Completed, Closed, or Approved."/></div>
                            <field name="value" placeholder="New value" nolabel="1"/>
                        </group>
                    </div>

                    <div class="wati_otp_card" invisible="action_type != 'send_whatsapp'">
                        <h3>Send a WhatsApp message</h3>
                        <p class="text-muted">The message is sent to the same customer number used by this OTP flow.</p>
                        <group>
                            <div class="d-flex align-items-center gap-1 mb-1"><strong>WhatsApp template</strong><i class="fa fa-question-circle text-muted" title="Choose the approved WATI template that should be sent after successful OTP verification."/></div>
                            <field name="template_id" options="{'no_create': True}" nolabel="1"/>
                            <div class="d-flex align-items-center gap-1 mb-1 mt-2"><strong>WATI channel</strong><i class="fa fa-question-circle text-muted" title="Optional. Use a specific WATI sending number for this follow-up message, or leave blank for the normal channel."/></div>
                            <field name="channel_number" placeholder="Optional — use a specific WATI number" nolabel="1"/>
                        </group>
                        <div invisible="not template_id">
                            <h4>Template variables <i class="fa fa-question-circle text-muted" title="Map each WhatsApp template variable to a value from the Odoo record or to a fixed value."/></h4>
                            <field name="binding_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="variable_name" readonly="1"/>
                                    <field name="source_type"/>
                                    <field name="field_path" invisible="source_type != 'record'" placeholder="Example: partner_id.name"/>
                                    <field name="static_value" invisible="source_type != 'static'"/>
                                </list>
                            </field>
                        </div>
                    </div>

                    <div class="wati_otp_card" invisible="action_type != 'server_action'">
                        <h3>Run an Odoo server action</h3>
                        <p class="text-muted">Use this for advanced workflows that already exist in Odoo.</p>
                        <group>
                            <div class="d-flex align-items-center gap-1 mb-1"><strong>Server action</strong><i class="fa fa-question-circle text-muted" title="Choose an existing Odoo Server Action for advanced logic such as creating records, calling custom code, or running a larger workflow."/></div>
                            <field name="server_action_id" options="{'no_create': True}" nolabel="1"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wati_otp_transaction_list_workflow" model="ir.ui.view">
        <field name="name">wati.otp.transaction.list.workflow</field>
        <field name="model">wati.otp.transaction</field>
        <field name="inherit_id" ref="wati_connector.view_wati_otp_transaction_list"/>
        <field name="priority">280</field>
        <field name="arch" type="xml">
            <field name="attempt_count" position="after">
                <field name="post_actions_state" widget="badge" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_wati_otp_transaction_form_workflow" model="ir.ui.view">
        <field name="name">wati.otp.transaction.form.workflow</field>
        <field name="model">wati.otp.transaction</field>
        <field name="inherit_id" ref="wati_connector.view_wati_otp_transaction_form"/>
        <field name="priority">280</field>
        <field name="arch" type="xml">
            <field name="attempt_count" position="after">
                <field name="post_actions_state" widget="badge"/>
                <field name="post_actions_error" invisible="not post_actions_error"/>
            </field>
        </field>
    </record>
</odoo>
