<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_wati_identity_approval" model="ir.ui.view">
        <field name="name">res.users.wati.identity.approval</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="wati_connector.view_users_form_wati"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wati_operator_email']" position="after">
                <div class="mt-3" groups="base.group_system">
                    <label for="wati_approved_operator_email" string="Approved WATI Agent Email" class="fw-bold d-block mb-1"/>
                    <field name="wati_approved_operator_email" nolabel="1" placeholder="agent@company.com"/>
                    <p class="text-muted mt-1">Administrator: verify the actual Agent in WATI before entering this approved email. If Operator Email changes, inbox access is blocked until it matches again. Existing agents with a matching prior assignment remain compatible.</p>
                </div>
            </xpath>
        </field>
    </record>

    <template id="wati_inbox_identity_blocked" name="WATI Inbox Agent Identity Warning">
        <html lang="en" dir="ltr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex,nofollow"/>
                <title>WhatsApp Inbox | Agent verification required</title>
                <link rel="stylesheet" href="/wati_connector/static/src/inbox/inbox.css"/>
            </head>
            <body style="margin:0;background:#f6f8fb;">
                <div class="wati-app">
                    <header class="wati-topbar">
                        <div class="wati-brand"><div class="wati-logo">W</div><div><strong>WhatsApp Inbox</strong><span>WATI × Odoo</span></div></div>
                        <div class="wati-topbar-actions"><span class="wati-agent"><t t-esc="user_name"/></span><a class="wati-odoo-link" href="/odoo">Back to Odoo</a></div>
                    </header>
                    <main class="wati-workspace" style="display:flex;align-items:center;justify-content:center;padding:32px;">
                        <section role="alert" style="max-width:650px;width:100%;padding:36px;background:white;border:1px solid #e2e8f0;border-radius:18px;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.05);">
                            <div style="font-size:38px;margin-bottom:12px;">⚠</div>
                            <h1 style="font-size:23px;margin:0 0 14px;">WATI Agent verification required</h1>
                            <p style="font-size:16px;line-height:1.7;color:#475569;" t-esc="identity_error"/>
                            <p style="color:#64748b;">Conversations and messages are hidden until your WATI email is corrected and approved.</p>
                            <a href="/wati/inbox" style="display:inline-block;margin-top:16px;padding:12px 25px;background:#128c7e;color:white;text-decoration:none;border-radius:10px;">Retry after correction</a>
                        </section>
                    </main>
                </div>
            </body>
        </html>
    </template>

    <template id="wati_inbox_identity_script" inherit_id="wati_connector.wati_inbox_page">
        <xpath expr="//script[contains(@src, '/static/src/inbox/inbox.js')]" position="before">
            <script src="/wati_connector/static/src/inbox/inbox_identity.js?v=1" defer="defer"/>
        </xpath>
    </template>
</odoo>
