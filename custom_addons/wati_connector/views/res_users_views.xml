<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_wati" model="ir.ui.view">
        <field name="name">res.users.form.wati</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp / WATI" name="wati_user_integration">
                    <group>
                        <group string="Link the employee account">
                            <field name="wati_operator_email"
                                   string="WATI Operator Email"
                                   placeholder="employee@company.com"/>
                            <div class="text-muted">
                                Enter the employee’s email as registered inside WATI Team Inbox.
                            </div>
                        </group>
                        <group string="Roles WhatsApp">
                            <div class="text-muted">
                                <strong>WATI User / Agent:</strong> For everyday use and customer service.<br/>
                                <strong>WATI Supervisor:</strong> To supervise the team and relay conversations.<br/>
                                <strong>WATI Administrator:</strong> He «Supervisor WhatsApp» On which the permissions settings of services such as Automation Center, Operation Log, and Monitoring depend Webhook.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="How it works">
                            <div class="text-muted">
                                Unpredicated conversation can Agent Receive it. After receipt, no other employee can respond to it.
                                Conversation transfer between employees is available to a moderator WATI Or AdministratorAll transfers are saved in the attribution log.
                            </div>
                        </group>
                        <group string="Security note">
                            <div class="alert alert-light border" role="status">
                                The director is not granted authority «Administrator Odoo» Just to manage WhatsApp. Use role
                                <strong>WATI Administrator</strong> Its access is limited to a space WhatsApp And the powers you have chosen for the company.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
