<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_wati" model="ir.ui.view">
        <field name="name">res.users.form.wati</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp / WATI" name="wati_user_integration">
                    <group>
                        <group string="ربط حساب الموظف">
                            <field name="wati_operator_email"
                                   string="WATI Operator Email"
                                   placeholder="employee@company.com"/>
                            <div class="text-muted">
                                أدخل إيميل الموظف كما هو مسجل داخل WATI Team Inbox.
                            </div>
                        </group>
                        <group string="أدوار WhatsApp">
                            <div class="text-muted">
                                <strong>WATI User / Agent:</strong> للاستخدام اليومي وخدمة العملاء.<br/>
                                <strong>WATI Supervisor:</strong> للإشراف على الفريق ونقل المحادثات.<br/>
                                <strong>WATI Administrator:</strong> هو «مشرف WhatsApp» الذي تعتمد عليه إعدادات صلاحيات الخدمات مثل مركز الأتمتة وسجل التشغيل ومراقبة Webhook.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="طريقة العمل">
                            <div class="text-muted">
                                المحادثة غير المسندة يستطيع Agent استلامها. بعد الاستلام لا يستطيع موظف آخر الرد عليها.
                                نقل المحادثة بين الموظفين متاح لمشرف WATI أو Administrator، وجميع عمليات النقل تُحفظ في سجل الإسناد.
                            </div>
                        </group>
                        <group string="ملاحظة أمنية">
                            <div class="alert alert-light border" role="status">
                                لا تمنح المديرة صلاحية «مدير Odoo» فقط لكي تدير WhatsApp. استخدم دور
                                <strong>WATI Administrator</strong> ليكون وصولها محصورًا في مساحة WhatsApp والصلاحيات التي اخترتها للشركة.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
