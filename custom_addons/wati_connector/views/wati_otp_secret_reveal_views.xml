<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_otp_flow_form_secret_reveal" model="ir.ui.view">
        <field name="name">wati.otp.flow.form.secret.reveal</field>
        <field name="model">wati.otp.flow</field>
        <field name="inherit_id" ref="wati_connector.view_wati_otp_flow_form_universal_triggers"/>
        <field name="priority">360</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('wati_otp_info') and .//field[@name='integration_secret']]" position="replace">
                <div class="wati_otp_info mt-3" groups="base.group_system">
                    <i class="fa fa-key" title="Integration security"/>
                    <div class="w-100">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <div>
                                <strong>External entry-point security</strong>
                                <span>REST API, webhook, and website/form requests require this flow's integration secret. Portal requests use the signed-in user's Odoo permissions.</span>
                            </div>
                            <span class="badge rounded-pill text-bg-light">System Admin only</span>
                        </div>

                        <div class="mt-3 p-3 rounded border bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                                <div>
                                    <strong>Integration secret</strong>
                                    <div class="text-muted small">Copy this value into the <code>X-WATI-OTP-Secret</code> header for external requests.</div>
                                </div>
                                <button name="action_regenerate_integration_secret" type="object" string="Regenerate secret" class="btn btn-secondary" icon="fa-refresh"/>
                            </div>
                            <field name="integration_secret" readonly="1" nolabel="1" widget="CopyClipboardChar" class="font-monospace"/>
                            <div class="text-muted small mt-2">Regenerating the secret immediately invalidates the previous value.</div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
