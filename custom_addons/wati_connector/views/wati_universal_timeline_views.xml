<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_universal_timeline_wizard_form" model="ir.ui.view">
        <field name="name">wati.universal.timeline.wizard.form</field>
        <field name="model">wati.universal.timeline.wizard</field>
        <field name="arch" type="xml">
            <form string="Register WhatsApp">
                <sheet>
                    <div class="oe_title">
                        <h2>Register WhatsApp</h2>
                        <div class="text-muted">Displays date WhatsApp Linked to the current record through the customer or mobile number.</div>
                    </div>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="message_count"/>
                            <field name="last_message_at"/>
                        </group>
                    </group>
                    <field name="rule_id" invisible="1"/>
                    <field name="source_model" invisible="1"/>
                    <field name="source_res_id" invisible="1"/>
                    <field name="message_ids" readonly="1" nolabel="1">
                        <list create="false" edit="false" delete="false" default_order="received_at desc, id desc"
                              decoration-success="direction == 'outbound'"
                              decoration-info="direction == 'inbound'">
                            <field name="received_at" string="time"/>
                            <field name="direction" string="direction" widget="badge"/>
                            <field name="message_type" string="Type" optional="hide"/>
                            <field name="text" string="The message"/>
                            <field name="status" string="Status" widget="badge"/>
                            <field name="operator_name" string="Employee" optional="show"/>
                            <field name="channel_phone_number" string="Channel" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_open_full_timeline" type="object" string="Open full history" class="btn-primary" icon="fa-external-link"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wati_universal_timeline" model="ir.actions.act_window">
        <field name="name">Register WhatsApp</field>
        <field name="res_model">wati.universal.timeline.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
