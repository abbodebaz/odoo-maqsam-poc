<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_rule_list" model="ir.ui.view">
        <field name="name">wati.automation.rule.list</field>
        <field name="model">wati.automation.rule</field>
        <field name="arch" type="xml">
            <list string="Rules WhatsApp Automation" decoration-success="active" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="trigger_field_id"/>
                <field name="condition_operator"/>
                <field name="target_value"/>
                <field name="template_name"/>
                <field name="once_per_record"/>
                <field name="success_count"/>
                <field name="failure_count"/>
            </list>
        </field>
    </record>

    <record id="view_wati_automation_rule_form" model="ir.ui.view">
        <field name="name">wati.automation.rule.form</field>
        <field name="model">wati.automation.rule</field>
        <field name="arch" type="xml">
            <form string="Base WhatsApp Automation">
                <header>
                    <button name="action_sync" type="object" string="Sync with Odoo" class="btn-primary" icon="fa-refresh"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list-alt">
                            <field name="run_count" widget="statinfo" string="Operations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Example: Submit when an opportunity qualifies"/></h1>
                    </div>

                    <group string="1. When do you send the message?">
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="trigger_field_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="condition_operator"/>
                            <field name="target_value" placeholder="Example: Qualified"/>
                        </group>
                    </group>

                    <group string="2. Who do we send to?">
                        <group>
                            <field name="recipient_field_id" options="{'no_create': True}"/>
                            <field name="recipient_path" placeholder="Example: partner_id.mobile"/>
                        </group>
                        <group>
                            <field name="once_per_record"/>
                            <field name="channel_number" placeholder="Optional"/>
                        </group>
                    </group>

                    <group string="3. What do we send?">
                        <group>
                            <field name="template_name" placeholder="Example: cr27_3"/>
                        </group>
                    </group>

                    <separator string="4. Link variables WATI With data Odoo"/>
                    <field name="parameter_ids" nolabel="1">
                        <list editable="bottom" string="Template variables">
                            <field name="sequence" widget="handle"/>
                            <field name="param_name" placeholder="cr_clint2"/>
                            <field name="source_type"/>
                            <field name="model_id" column_invisible="True"/>
                            <field name="source_field_id" options="{'no_create': True}"/>
                            <field name="source_path" placeholder="partner_id.name"/>
                            <field name="static_value" placeholder="Fixed value"/>
                        </list>
                    </field>

                    <notebook>
                        <page string="Follow up">
                            <group>
                                <group>
                                    <field name="run_count" readonly="1"/>
                                    <field name="success_count" readonly="1"/>
                                    <field name="failure_count" readonly="1"/>
                                </group>
                                <group string="Internal engine" groups="base.group_system">
                                    <field name="model_name" readonly="1"/>
                                    <field name="base_automation_id" readonly="1"/>
                                    <field name="server_action_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wati_automation_rules" model="ir.actions.act_window">
        <field name="name">Automation WhatsApp</field>
        <field name="res_model">wati.automation.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first base WhatsApp Without writing code</p>
            <p>Select Application, Field, Condition, Template WATI Link its variables to data Odoo.</p>
        </field>
    </record>

    <record id="view_wati_automation_log_list" model="ir.ui.view">
        <field name="name">wati.automation.log.list</field>
        <field name="model">wati.automation.log</field>
        <field name="arch" type="xml">
            <list string="Register WhatsApp Automation" create="false" edit="false" delete="false" decoration-success="status == 'sent'" decoration-danger="status == 'failed'">
                <field name="create_date"/>
                <field name="status"/>
                <field name="rule_id"/>
                <field name="res_name"/>
                <field name="phone"/>
                <field name="template_name"/>
                <field name="triggered_by_id"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_wati_automation_log_form" model="ir.ui.view">
        <field name="name">wati.automation.log.form</field>
        <field name="model">wati.automation.log</field>
        <field name="arch" type="xml">
            <form string="Running details WhatsApp" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="status"/>
                            <field name="rule_id"/>
                            <field name="template_name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                            <field name="triggered_by_id"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="response WATI" invisible="not response_excerpt">
                        <field name="response_excerpt" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wati_automation_logs" model="ir.actions.act_window">
        <field name="name">Automation record</field>
        <field name="res_model">wati.automation.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_wati_automation_rules" name="⚡ Automation" parent="menu_wati_root" action="action_wati_automation_rules" sequence="30"/>
    <menuitem id="menu_wati_automation_logs" name="Automation record" parent="menu_wati_root" action="action_wati_automation_logs" sequence="35"/>
</odoo>
