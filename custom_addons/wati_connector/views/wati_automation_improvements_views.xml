<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_rule_form_improvements" model="ir.ui.view">
        <field name="name">wati.automation.rule.form.improvements</field>
        <field name="model">wati.automation.rule</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_name']" position="after">
                <button name="action_fetch_template_params"
                        type="object"
                        string="Fetch template variables from WATI"
                        icon="fa-download"
                        class="btn-secondary"/>
            </xpath>

            <xpath expr="//field[@name='parameter_ids']" position="before">
                <div class="alert alert-info" role="alert">
                    <strong>Without writing Variables Manually:</strong>
                    After saving the template name, click «Fetch template variables from WATI»Then associate each variable with a field Odoo appropriate.
                    can be used «Fixed value / backup» If the field may be empty.
                </div>
            </xpath>

            <xpath expr="//field[@name='static_value']" position="attributes">
                <attribute name="string">Fixed value / backup</attribute>
                <attribute name="placeholder">Fixed or alternative value when a field is empty Odoo</attribute>
            </xpath>
        </field>
    </record>
</odoo>
