<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_automation_rule_form_extra_conditions" model="ir.ui.view">
        <field name="name">wati.automation.rule.form.extra.conditions</field>
        <field name="model">wati.automation.rule</field>
        <field name="inherit_id" ref="wati_connector.view_wati_automation_rule_form_ux"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='target_value']" position="after">
                <field name="condition_ids" string="Additional terms (Optional)" colspan="2">
                    <list editable="bottom" string="Additional terms">
                        <field name="sequence" widget="handle"/>
                        <field name="model_id" column_invisible="True"/>
                        <field name="field_id" string="Provided that" options="{'no_create': True}"/>
                        <field name="operator" string="Condition"/>
                        <field name="target_value" string="Value"
                               invisible="operator in ('is_set', 'is_not_set')"
                               placeholder="Example: Yes or stage name"/>
                    </list>
                </field>
                <div class="text-muted" colspan="2">
                    All additional conditions must be met along with the primary event before the message is sent. Example: stage = Accomplished + Field service assignment = Yes.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
