<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_conversation_list" model="ir.ui.view">
        <field name="name">wati.conversation.list</field>
        <field name="model">wati.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversation Log" create="false" edit="false" delete="false" default_order="last_message_at desc, id desc">
                <field name="last_message_at" string="Last Activity"/>
                <field name="name" string="Customer"/>
                <field name="wa_id" string="WhatsApp Number"/>
                <field name="assigned_user_id" string="Assigned Agent"/>
                <field name="status" string="Status"/>
                <field name="unread_count" string="Unread"/>
                <field name="last_message" string="Last Message"/>
                <field name="partner_id" string="Odoo Contact" optional="hide"/>
                <field name="operator_name" string="WATI Agent" optional="hide"/>
                <field name="conversation_uid" string="Conversation ID" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wati_conversation_search" model="ir.ui.view">
        <field name="name">wati.conversation.search</field>
        <field name="model">wati.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="name" string="Customer"/>
                <field name="wa_id" string="WhatsApp Number"/>
                <field name="assigned_user_id" string="Assigned Agent"/>
                <field name="status" string="Status"/>
                <field name="last_message" string="Last Message"/>
                <separator/>
                <filter name="unread" string="Unread" domain="[('unread_count', '&gt;', 0)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('assigned_user_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_wati_conversation_form" model="ir.ui.view">
        <field name="name">wati.conversation.form</field>
        <field name="model">wati.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation Details" create="false" delete="false">
                <header>
                    <button name="action_open_reply_wizard" type="object" string="Reply on WhatsApp" class="btn-primary" icon="fa-reply"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="wa_id"/>
                            <field name="conversation_uid"/>
                            <field name="ticket_uid" optional="hide"/>
                            <field name="status"/>
                            <field name="unread_count"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="assigned_at"/>
                            <field name="operator_name"/>
                            <field name="operator_email"/>
                            <field name="partner_id"/>
                            <field name="last_message_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="last_message"/>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list create="false" delete="false">
                            <field name="received_at" string="Time"/>
                            <field name="direction"/>
                            <field name="sender_name"/>
                            <field name="message_type" string="Type"/>
                            <field name="text" string="Content"/>
                            <field name="status"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wati_reply_wizard_form" model="ir.ui.view">
        <field name="name">wati.reply.wizard.form</field>
        <field name="model">wati.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Reply on WhatsApp">
                <group>
                    <field name="conversation_id"/>
                    <field name="wa_id"/>
                    <field name="message" placeholder="Write your message..." nolabel="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wati_inbox" model="ir.actions.act_url">
        <field name="name">Inbox</field>
        <field name="url">/wati/inbox</field>
        <field name="target">self</field>
    </record>

    <record id="action_wati_conversations" model="ir.actions.act_window">
        <field name="name">Conversation Log</field>
        <field name="res_model">wati.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wati_conversation_search"/>
    </record>

    <record id="view_wati_message_list" model="ir.ui.view">
        <field name="name">wati.message.list</field>
        <field name="model">wati.message</field>
        <field name="arch" type="xml">
            <list string="Message Log" create="false" edit="false" delete="false" default_order="received_at desc, id desc">
                <field name="received_at" string="Time"/>
                <field name="conversation_id" string="Conversation"/>
                <field name="direction" string="Direction"/>
                <field name="wa_id" string="WhatsApp Number"/>
                <field name="sender_name" string="Sender"/>
                <field name="message_type" string="Type"/>
                <field name="text" string="Content"/>
                <field name="status" string="Status"/>
                <field name="operator_name" string="Agent" optional="hide"/>
                <field name="whatsapp_message_id" string="WhatsApp Message ID" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wati_message_search" model="ir.ui.view">
        <field name="name">wati.message.search</field>
        <field name="model">wati.message</field>
        <field name="arch" type="xml">
            <search string="Search Messages">
                <field name="wa_id" string="WhatsApp Number"/>
                <field name="sender_name" string="Sender"/>
                <field name="conversation_id" string="Conversation"/>
                <field name="message_type" string="Type"/>
                <field name="status" string="Status"/>
                <separator/>
                <filter name="inbound" string="Incoming" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outgoing" domain="[('direction', '=', 'outbound')]"/>
            </search>
        </field>
    </record>

    <record id="action_wati_messages" model="ir.actions.act_window">
        <field name="name">Message Log</field>
        <field name="res_model">wati.message</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_wati_message_search"/>
    </record>

    <record id="view_wati_webhook_event_list" model="ir.ui.view">
        <field name="name">wati.webhook.event.list</field>
        <field name="model">wati.webhook.event</field>
        <field name="arch" type="xml">
            <list string="WATI Webhook Events" create="false" edit="false" delete="false">
                <field name="received_at"/>
                <field name="event_type"/>
                <field name="external_id"/>
                <field name="wa_id"/>
                <field name="conversation_uid"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_wati_webhook_events" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">wati.webhook.event</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_wati_root" name="WhatsApp" sequence="96"/>
    <menuitem id="menu_wati_inbox" name="Inbox" parent="menu_wati_root" action="action_wati_inbox" sequence="5"/>
    <menuitem id="menu_wati_conversations" name="Conversation Log" parent="menu_wati_root" action="action_wati_conversations" sequence="10"/>
    <menuitem id="menu_wati_messages" name="Message Log" parent="menu_wati_root" action="action_wati_messages" sequence="20"/>
    <menuitem id="menu_wati_webhook_events" name="Webhook Events" parent="menu_wati_root" action="action_wati_webhook_events" groups="base.group_system" sequence="90"/>
</odoo>