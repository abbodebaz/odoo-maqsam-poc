<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_conversation_list" model="ir.ui.view">
        <field name="name">wati.conversation.list</field>
        <field name="model">wati.conversation</field>
        <field name="arch" type="xml">
            <list string="محادثات WhatsApp" create="false" delete="false">
                <field name="name"/>
                <field name="wa_id"/>
                <field name="operator_name"/>
                <field name="status"/>
                <field name="unread_count"/>
                <field name="last_message"/>
                <field name="last_message_at"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_wati_conversation_form" model="ir.ui.view">
        <field name="name">wati.conversation.form</field>
        <field name="model">wati.conversation</field>
        <field name="arch" type="xml">
            <form string="محادثة WhatsApp" create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="wa_id"/>
                            <field name="conversation_uid"/>
                            <field name="ticket_uid"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="operator_name"/>
                            <field name="operator_email"/>
                            <field name="partner_id"/>
                            <field name="last_message_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="last_message"/>
                    </group>
                    <field name="message_ids" readonly="1">
                        <list create="false" delete="false">
                            <field name="received_at"/>
                            <field name="direction"/>
                            <field name="sender_name"/>
                            <field name="text"/>
                            <field name="status"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wati_conversations" model="ir.actions.act_window">
        <field name="name">المحادثات</field>
        <field name="res_model">wati.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_wati_message_list" model="ir.ui.view">
        <field name="name">wati.message.list</field>
        <field name="model">wati.message</field>
        <field name="arch" type="xml">
            <list string="رسائل WhatsApp" create="false" edit="false" delete="false">
                <field name="received_at"/>
                <field name="direction"/>
                <field name="wa_id"/>
                <field name="sender_name"/>
                <field name="message_type"/>
                <field name="text"/>
                <field name="status"/>
                <field name="operator_name"/>
            </list>
        </field>
    </record>

    <record id="action_wati_messages" model="ir.actions.act_window">
        <field name="name">الرسائل</field>
        <field name="res_model">wati.message</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_wati_webhook_event_list" model="ir.ui.view">
        <field name="name">wati.webhook.event.list</field>
        <field name="model">wati.webhook.event</field>
        <field name="arch" type="xml">
            <list string="WATI Webhook Events" create="false" edit="false" delete="false">
                <field name="received_at"/>
                <field name="event_type"/>
                <field name="external_id"/>
                <field name="wa_id"/>
                <field name="conversation_uid"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_wati_webhook_events" model="ir.actions.act_window">
        <field name="name">أحداث Webhook</field>
        <field name="res_model">wati.webhook.event</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_wati_root" name="WhatsApp" sequence="96"/>
    <menuitem id="menu_wati_conversations" name="المحادثات" parent="menu_wati_root" action="action_wati_conversations" sequence="10"/>
    <menuitem id="menu_wati_messages" name="الرسائل" parent="menu_wati_root" action="action_wati_messages" sequence="20"/>
    <menuitem id="menu_wati_webhook_events" name="أحداث Webhook" parent="menu_wati_root" action="action_wati_webhook_events" groups="base.group_system" sequence="90"/>
</odoo>
