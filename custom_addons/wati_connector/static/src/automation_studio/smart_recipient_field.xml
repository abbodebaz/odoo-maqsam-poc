<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wati_connector.WatiSmartRecipientField">
        <t t-if="props.readonly">
            <span t-esc="currentValue"/>
        </t>
        <t t-elif="metadata.mode === 'select'">
            <select class="o_input wati_smart_recipient_select" t-on-change="onValueChange">
                <option value="" t-att-selected="!currentValue" t-esc="placeholder"/>
                <option t-foreach="options"
                        t-as="option"
                        t-key="option.value"
                        t-att-value="option.value"
                        t-att-selected="option.value === currentValue"
                        t-esc="option.label"/>
            </select>
        </t>
        <t t-else="">
            <div class="wati_smart_recipient_empty">There are no appropriate phone fields in this path.</div>
        </t>
    </t>
</templates>
