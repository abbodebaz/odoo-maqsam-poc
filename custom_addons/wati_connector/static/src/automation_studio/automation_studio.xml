<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wati_connector.WatiAutomationStudio">
        <div class="o_wati_studio" dir="ltr">
            <div class="o_wati_studio_hero">
                <div class="o_wati_studio_hero_copy">
                    <div class="o_wati_studio_eyebrow">WhatsApp Automation Studio</div>
                    <h1>Automation Center</h1>
                    <p>Build smart WhatsApp automations inside Odoo, monitor their results, and quickly identify anything that needs attention.</p>
                </div>
                <div class="o_wati_studio_hero_actions">
                    <button class="btn btn-light o_wati_studio_logs" t-on-click="openLogs">
                        <i class="fa fa-list-alt me-2"/> Run Log
                    </button>
                    <button class="btn btn-primary o_wati_studio_create" t-on-click="createAutomation">
                        <i class="fa fa-plus me-2"/> Create Automation
                    </button>
                </div>
            </div>

            <div class="o_wati_studio_kpis">
                <div class="o_wati_kpi_card">
                    <div class="o_wati_kpi_icon is-active"><i class="fa fa-bolt"/></div>
                    <div><span>Active Automations</span><strong t-esc="state.kpis.active"/></div>
                </div>
                <div class="o_wati_kpi_card">
                    <div class="o_wati_kpi_icon is-attention"><i class="fa fa-exclamation-triangle"/></div>
                    <div><span>Need Attention</span><strong t-esc="state.kpis.attention"/></div>
                </div>
                <div class="o_wati_kpi_card">
                    <div class="o_wati_kpi_icon is-runs"><i class="fa fa-play-circle"/></div>
                    <div><span>Runs Today</span><strong t-esc="state.kpis.runsToday"/></div>
                </div>
                <div class="o_wati_kpi_card">
                    <div class="o_wati_kpi_icon is-success"><i class="fa fa-line-chart"/></div>
                    <div><span>Success Rate</span><strong><t t-esc="state.kpis.successRate"/>%</strong></div>
                </div>
            </div>

            <div class="o_wati_studio_toolbar">
                <div class="o_wati_studio_filters">
                    <button t-att-class="'o_wati_filter ' + (state.filter === 'all' ? 'is-active' : '')" t-on-click="() => this.setFilter('all')">All</button>
                    <button t-att-class="'o_wati_filter ' + (state.filter === 'active' ? 'is-active' : '')" t-on-click="() => this.setFilter('active')">Active</button>
                    <button t-att-class="'o_wati_filter ' + (state.filter === 'attention' ? 'is-active' : '')" t-on-click="() => this.setFilter('attention')">Need Attention</button>
                    <button t-att-class="'o_wati_filter ' + (state.filter === 'paused' ? 'is-active' : '')" t-on-click="() => this.setFilter('paused')">Paused</button>
                </div>
                <div class="o_wati_studio_search">
                    <i class="fa fa-search"/>
                    <input type="search" placeholder="Search by automation or template name..." t-model="state.query"/>
                </div>
            </div>

            <div t-if="state.loading" class="o_wati_studio_loading">
                <i class="fa fa-circle-o-notch fa-spin"/> Loading Automation Center...
            </div>

            <div t-else="" class="o_wati_studio_grid">
                <t t-if="filteredRules.length">
                    <t t-foreach="filteredRules" t-as="rule" t-key="rule.id">
                        <article class="o_wati_rule_card" t-on-click="() => this.openRule(rule.id)">
                            <div class="o_wati_rule_card_top">
                                <div class="o_wati_rule_app_icon"><i class="fa fa-whatsapp"/></div>
                                <div class="o_wati_rule_identity">
                                    <div class="o_wati_rule_title_row">
                                        <h3 t-esc="rule.name"/>
                                        <span t-att-class="'o_wati_rule_status ' + (rule.active ? 'is-on' : 'is-off')">
                                            <i t-att-class="rule.active ? 'fa fa-circle' : 'fa fa-pause-circle'"/>
                                            <t t-esc="rule.active ? 'Active' : 'Paused'"/>
                                        </span>
                                    </div>
                                    <span class="o_wati_rule_model" t-esc="modelLabel(rule)"/>
                                </div>
                            </div>

                            <div class="o_wati_rule_summary" t-esc="rule.human_summary || 'WhatsApp automation inside Odoo'"/>

                            <div class="o_wati_rule_meta">
                                <div class="o_wati_rule_meta_item">
                                    <span>Template</span>
                                    <strong t-esc="rule.template_name || 'Not selected yet'"/>
                                </div>
                                <div class="o_wati_rule_meta_item">
                                    <span>Readiness</span>
                                    <strong t-att-class="'o_wati_readiness ' + readinessClass(rule.readiness_state)" t-esc="readinessLabel(rule.readiness_state)"/>
                                </div>
                            </div>

                            <div class="o_wati_rule_health">
                                <div><span class="is-success"><i class="fa fa-check"/> Successful</span><strong t-esc="rule.success_count || 0"/></div>
                                <div><span class="is-failure"><i class="fa fa-times"/> Failed</span><strong t-esc="rule.failure_count || 0"/></div>
                                <div><span><i class="fa fa-history"/> Total</span><strong t-esc="rule.run_count || 0"/></div>
                            </div>

                            <div class="o_wati_rule_footer">
                                <span>Open Automation</span>
                                <i class="fa fa-arrow-right"/>
                            </div>
                        </article>
                    </t>
                </t>
                <div t-else="" class="o_wati_studio_empty">
                    <div class="o_wati_empty_icon"><i class="fa fa-bolt"/></div>
                    <h3>No automations found</h3>
                    <p>Change the filter or create your first smart WhatsApp automation.</p>
                    <button class="btn btn-primary" t-on-click="createAutomation">Create Automation</button>
                </div>
            </div>
        </div>
    </t>
</templates>