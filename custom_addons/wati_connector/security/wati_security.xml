<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_wati" model="ir.module.category">
        <field name="name">WATI WhatsApp</field>
        <field name="description">Roles and permissions for the WATI WhatsApp Connector.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_wati_whatsapp" model="res.groups.privilege">
        <field name="name">WATI WhatsApp</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="wati_connector.module_category_wati"/>
    </record>

    <record id="group_wati_user" model="res.groups">
        <field name="name">WATI User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="wati_connector.privilege_wati_whatsapp"/>
    </record>

    <record id="group_wati_agent" model="res.groups">
        <field name="name">WATI Agent</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="wati_connector.privilege_wati_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('wati_connector.group_wati_user'))]"/>
    </record>

    <record id="group_wati_supervisor" model="res.groups">
        <field name="name">WATI Supervisor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="wati_connector.privilege_wati_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('wati_connector.group_wati_agent'))]"/>
    </record>

    <record id="group_wati_admin" model="res.groups">
        <field name="name">WATI Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="wati_connector.privilege_wati_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('wati_connector.group_wati_supervisor'))]"/>
    </record>
</odoo>
