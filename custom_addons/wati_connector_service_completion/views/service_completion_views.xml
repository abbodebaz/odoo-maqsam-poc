<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wati_service_completion_task_list" model="ir.ui.view">
        <field name="name">wati.service.completion.task.list</field>
        <field name="model">wati.service.completion.task</field>
        <field name="arch" type="xml">
            <list string="Service Completion Tasks" default_order="id desc">
                <field name="name"/>
                <field name="external_reference"/>
                <field name="service_name"/>
                <field name="customer_id"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge"/>
                <field name="started_at" optional="hide"/>
                <field name="completed_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_wati_service_completion_task_search" model="ir.ui.view">
        <field name="name">wati.service.completion.task.search</field>
        <field name="model">wati.service.completion.task</field>
        <field name="arch" type="xml">
            <search string="Service Completion Tasks">
                <field name="name"/>
                <field name="external_reference"/>
                <field name="service_name"/>
                <field name="customer_id"/>
                <field name="assigned_user_id"/>
                <filter name="ready" string="Ready for Confirmation" domain="[('state', '=', 'ready')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_assignee" string="Driver / Technician" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wati_service_completion_task_form" model="ir.ui.view">
        <field name="name">wati.service.completion.task.form</field>
        <field name="model">wati.service.completion.task</field>
        <field name="arch" type="xml">
            <form string="Service Completion Task">
                <header>
                    <button name="action_start" type="object" string="Start Service" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_ready_for_confirmation" type="object" string="Ready for Confirmation" class="btn-primary" invisible="state not in ('new', 'in_progress')"/>
                    <button name="action_reset_to_progress" type="object" string="Back to In Progress" invisible="state != 'ready'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,ready,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="state != 'completed'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h2><field name="service_name" placeholder="Service name..."/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="external_reference" placeholder="Invoice, order, or service reference"/>
                            <field name="customer_id"/>
                            <field name="assigned_user_id"/>
                            <field name="customer_mobile" readonly="1"/>
                            <field name="customer_phone" readonly="1"/>
                        </group>
                        <group>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="location_url" widget="url"/>
                            <field name="access_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Photos" name="photos">
                            <group>
                                <group string="Before service">
                                    <field name="before_photo" widget="image" class="oe_avatar"/>
                                </group>
                                <group string="Completion proof">
                                    <field name="completion_photo" widget="image" class="oe_avatar"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add service notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_wati_service_completion_tasks" model="ir.actions.act_window">
        <field name="name">Service Completion</field>
        <field name="res_model">wati.service.completion.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wati_service_completion_task_search"/>
    </record>

    <menuitem id="menu_wati_service_completion_root" name="Service Completion" sequence="65" action="action_wati_service_completion_tasks"/>
    <menuitem id="menu_wati_service_completion_tasks" name="Tasks" parent="menu_wati_service_completion_root" action="action_wati_service_completion_tasks" sequence="10"/>
</odoo>
